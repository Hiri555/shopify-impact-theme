{%- comment -%}
  ============================================================================
  FREOS · PDP 13 — FREOS · 13 FAQ
  ----------------------------------------------------------------------------
  Accordeon natif : <details>/<summary>. Pas de JS, donc ca fonctionne meme
  si le script ne charge pas, et le moteur de recherche lit les reponses.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur
  dans ce fichier. Genere par build_pdp_sections.py -- modifier le generateur,
  pas ce fichier, sinon la prochaine generation ecrase la retouche.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--faq fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-faq">
      {%- for block in section.blocks -%}
        <details class="fr-faq-item" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="fr-faq-q">
            {{- block.settings.question -}}
            <span class="fr-faq-i" aria-hidden="true"></span>
          </summary>
          <div class="fr-faq-answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.src_items != blank -%}
      <div class="fr-sources">
        {%- if section.settings.src_title != blank -%}
          <p class="fr-sources-t">{{ section.settings.src_title }}</p>
        {%- endif -%}
        <ul>
          {%- assign rows = section.settings.src_items | newline_to_br | split: '<br />' -%}
          {%- for r in rows -%}
            {%- assign line = r | strip -%}
            {%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "FREOS · 13 FAQ",
  "tag": "section",
  "class": "freos-pdp-faq",
  "settings": [
    {
      "type": "header",
      "content": "Sources"
    },
    {
      "type": "text",
      "id": "src_title",
      "label": "Titre du bloc sources"
    },
    {
      "type": "textarea",
      "id": "src_items",
      "label": "Sources",
      "info": "Une par ligne."
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "q",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Reponse"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Ouverte au chargement",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS · 13 FAQ"
    }
  ]
}
{% endschema %}
