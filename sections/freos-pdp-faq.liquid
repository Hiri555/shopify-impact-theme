{%- comment -%}
  ============================================================================
  FREOS · PDP — FREOS · 10 FAQ
  ----------------------------------------------------------------------------
  Accordeon sobre : la question en serif, un « + » a droite qui bascule.
  <details> natif, donc ca fonctionne sans JavaScript et reste accessible
  au clavier.
  En bas la barre de garantie : c'est la derniere objection avant l'achat,
  elle doit etre la ou finit la lecture.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur.
  Genere par build_pdp_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--faq fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-faq">
      {%- for block in section.blocks -%}
        <details class="fr-faq-i" {{ block.shopify_attributes }}
                 {% if block.settings.open %}open{% endif %}>
          <summary class="fr-faq-q">
            <span>{{ block.settings.question }}</span>
            <i class="fr-faq-m" aria-hidden="true"></i>
          </summary>
          <div class="fr-faq-a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.guar_title != blank -%}
      <div class="fr-guarbar">
        <span class="fr-guarbar-i" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.7"><path d="M12 2.6l7.4 3v5.8c0 4.5-3.1 8.6-7.4 9.9-4.3-1.3-7.4-5.4-7.4-9.9V5.6z"
               stroke-linejoin="round"/><path d="M8.6 12.2l2.4 2.4 4.4-4.6" stroke-linecap="round"/></svg>
        </span>
        <span class="fr-guarbar-b">
          <b>{{ section.settings.guar_title }}</b>
          {%- if section.settings.guar_text != blank -%}
            <span>{{ section.settings.guar_text }}</span>
          {%- endif -%}
        </span>
        {%- if section.settings.guar_label != blank -%}
          <a class="fr-guarbar-a" href="{{ section.settings.guar_url | default: '#' }}">
            {{ section.settings.guar_label }}<span aria-hidden="true">&#8594;</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.src_title != blank -%}
      <div class="fr-faq-src">
        <p class="fr-faq-src-t">{{ section.settings.src_title }}</p>
        {{ section.settings.src_items }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS · 10 FAQ",
  "tag": "section",
  "class": "freos-pdp-faq",
  "settings": [
    {
      "type": "header",
      "content": "Barre de garantie"
    },
    {
      "type": "text",
      "id": "guar_title",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "guar_text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "guar_label",
      "label": "Libelle du lien"
    },
    {
      "type": "url",
      "id": "guar_url",
      "label": "Destination du lien"
    },
    {
      "type": "header",
      "content": "Sources"
    },
    {
      "type": "text",
      "id": "src_title",
      "label": "Titre des sources"
    },
    {
      "type": "richtext",
      "id": "src_items",
      "label": "Sources"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "wide",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "q",
      "name": "Domanda",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Reponse"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Ouverte au chargement",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
