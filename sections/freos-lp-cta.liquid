{%- comment -%}
  ============================================================================
  FREOS · LP — FREOS LP · Bottone
  ----------------------------------------------------------------------------
  Le bouton de milieu de page.

  Il ne rend RIEN si le libelle est vide : c'est la garantie qu'aucun appel a
  l'action n'apparait avant la revelation du produit.
  Le reglage `scope` choisit la feuille (fr-lp1 / fr-lp2 / fr-lp3).
  Genere par build_lp_sections_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}{% unless section.settings.rule %} no-rule{% endunless %}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
{%- if section.settings.kicker != blank -%}<p class="k">{{ section.settings.kicker }}</p>{%- endif -%}
  {%- if section.settings.label != blank -%}
    <div class="cta-mid">
      <a href="{{ section.settings.url | default: '/' }}">{{ section.settings.label }}</a>
      {%- if section.settings.sub != blank -%}<p>{{ section.settings.sub }}</p>{%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "FREOS LP · Bottone",
  "tag": "section",
  "class": "freos-lp-cta",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "info": "La petite ligne au-dessus du titre. Vide = rien."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Libelle",
      "info": "Vide = aucun bouton. Ne rien mettre avant la revelation du produit."
    },
    {
      "type": "text",
      "id": "url",
      "label": "Lien"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Ligne sous le bouton"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Page",
      "default": "fr-lp1",
      "info": "Choisit la feuille de style appliquee. Une section deplacee d'une LP a l'autre doit changer de page ici.",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "checkbox",
      "id": "rule",
      "label": "Filet de separation au-dessus",
      "info": "A decocher sur la premiere partie de l'article.",
      "default": true
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "FREOS LP · Bottone"
    }
  ]
}
{% endschema %}
