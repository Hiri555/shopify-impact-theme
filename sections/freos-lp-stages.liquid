{%- comment -%}
  ============================================================================
  FREOS · LP — FREOS LP · Tappe
  ----------------------------------------------------------------------------
  La progression « Prima / Poi / Poi / Oggi ». Chaque etape est un bloc.
  Le reglage `scope` choisit la feuille (fr-lp1 / fr-lp2 / fr-lp3).
  Genere par build_lp_sections_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}{% unless section.settings.rule %} no-rule{% endunless %}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
{%- if section.settings.kicker != blank -%}<p class="k">{{ section.settings.kicker }}</p>{%- endif -%}  <section class="section">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="prose">{{ section.settings.intro }}</div>{%- endif -%}
    <div class="stages">
      {%- for block in section.blocks -%}
        <div class="stage" {{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}<div class="stage-label">{{ block.settings.label }}</div>{%- endif -%}
          {%- if block.settings.title != blank -%}<h4>{{ block.settings.title }}</h4>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="stage-text">{{ block.settings.text }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.outro != blank -%}<div class="prose">{{ section.settings.outro }}</div>{%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "FREOS LP · Tappe",
  "tag": "section",
  "class": "freos-lp-stages",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "info": "La petite ligne au-dessus du titre. Vide = rien."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre de section"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "richtext",
      "id": "outro",
      "label": "Transition de fin"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Page",
      "default": "fr-lp1",
      "info": "Choisit la feuille de style appliquee. Une section deplacee d'une LP a l'autre doit changer de page ici.",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "checkbox",
      "id": "rule",
      "label": "Filet de separation au-dessus",
      "info": "A decocher sur la premiere partie de l'article.",
      "default": true
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Tappa",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Reperage"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre de l'etape"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS LP · Tappe"
    }
  ]
}
{% endschema %}
