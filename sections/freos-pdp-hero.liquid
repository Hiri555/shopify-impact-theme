{%- comment -%}
  ============================================================================
  FREOS · PDP — PREMIER ECRAN
  ----------------------------------------------------------------------------
  Galerie + buy box, sur le modele de rosalia-main-product.liquid (meme theme
  Impact, structure validee par le proprietaire).

  La galerie lit les ASSETS DU THEME, pas les medias produit : elle rend donc
  avant meme que le produit existe, et ne depend pas de `shopify store auth`.
  Quand le produit aura ses propres medias, basculer `source` sur "product".

  Ordre de la buy box, repris de la reference marche (dogsuppy.it) :
  note AVANT le prix, puis benefices, puis ATC, puis reassurance.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign p = product
  assign slides = section.settings.gallery_files | split: ','
-%}

<div class="fr fr-hero">
  <div class="wide">
    <div class="fr-hero-grid">

      {%- comment -%}--------------------------------------------- GALERIE ---{%- endcomment -%}
      <div class="fr-gal">
        <div class="fr-gal-main">
          {%- for f in slides -%}
            {%- assign file = f | strip -%}
            {%- if file != blank -%}
              <img
                class="fr-gal-slide{% if forloop.first %} is-on{% endif %}"
                data-i="{{ forloop.index0 }}"
                src="{{ file | asset_url }}"
                alt="{{ section.settings.gallery_alt | default: p.title }}"
                width="1400" height="1400"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if slides.size > 1 -%}
          <div class="fr-gal-thumbs" role="tablist">
            {%- for f in slides -%}
              {%- assign file = f | strip -%}
              {%- if file != blank -%}
                <button class="fr-gal-thumb{% if forloop.first %} is-on{% endif %}"
                        data-i="{{ forloop.index0 }}" type="button" role="tab"
                        aria-label="{{ forloop.index }}">
                  <img src="{{ file | asset_url }}" alt="" loading="lazy" width="160" height="160">
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}-------------------------------------------- BUY BOX ---{%- endcomment -%}
      <div class="fr-buy">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              <p class="chip" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

            {%- when 'title' -%}
              <h1 class="fr-buy-title" {{ block.shopify_attributes }}>
                {{ block.settings.text | default: p.title }}
              </h1>

            {%- when 'subtitle' -%}
              <p class="fr-buy-sub" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

            {%- when 'rating' -%}
              <div class="fr-rate" {{ block.shopify_attributes }}>
                <span class="fr-rate-stars" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6z"/></svg>
                  {%- endfor -%}
                </span>
                <span class="fr-rate-n">{{ block.settings.score }}</span>
                <span class="fr-rate-c">{{ block.settings.count }}</span>
              </div>

            {%- when 'pills' -%}
              <div class="fr-pills" {{ block.shopify_attributes }}>
                {%- assign items = block.settings.items | split: '|' -%}
                {%- for it in items -%}<span class="fr-pill">{{ it | strip }}</span>{%- endfor -%}
              </div>

            {%- when 'price' -%}
              <div class="fr-price" {{ block.shopify_attributes }}>
                {%- if p -%}
                  <span class="fr-price-v">{{ p.price | money }}</span>
                {%- else -%}
                  <span class="fr-price-v">{{ block.settings.fallback }}</span>
                {%- endif -%}
                {%- if block.settings.note != blank -%}
                  <span class="fr-price-n">{{ block.settings.note }}</span>
                {%- endif -%}
              </div>

            {%- when 'benefits' -%}
              <ul class="fr-benefits" {{ block.shopify_attributes }}>
                {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for it in items -%}
                  {%- assign line = it | strip -%}
                  {%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'recognition' -%}
              <div class="fr-reco" {{ block.shopify_attributes }}>
                <p class="fr-reco-q">{{ block.settings.question }}</p>
                <div class="fr-reco-opts">
                  {%- assign items = block.settings.options | newline_to_br | split: '<br />' -%}
                  {%- for it in items -%}
                    {%- assign line = it | strip -%}
                    {%- if line != blank -%}
                      <button type="button" class="fr-reco-o">{{ line }}</button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="fr-reco-a" hidden>{{ block.settings.answer }}</p>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="fr-atc-wrap" {{ block.shopify_attributes }}>
                {%- if p and p.available -%}
                  {%- form 'product', p, id: 'freos-atc-form', class: 'fr-atc-form' -%}
                    <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="fr-atc">{{ block.settings.label }}</button>
                  {%- endform -%}
                {%- else -%}
                  <button type="button" class="fr-atc is-off" disabled>{{ block.settings.soldout }}</button>
                {%- endif -%}
                {%- if block.settings.under != blank -%}
                  <p class="fr-atc-under">{{ block.settings.under }}</p>
                {%- endif -%}
              </div>

            {%- when 'badges' -%}
              <div class="fr-tbadges" {{ block.shopify_attributes }}>
                {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for it in items -%}
                  {%- assign c = it | strip | split: '|' -%}
                  {%- if c.size >= 1 and c[0] != blank -%}
                    <div class="fr-tbadge">
                      <b>{{ c[0] | strip }}</b>
                      {%- if c[1] -%}<span>{{ c[1] | strip }}</span>{%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'guarantee' -%}
              <div class="fr-guar-box" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{%- if section.settings.sticky_atc -%}
  <div class="fr fr-sticky" id="fr-sticky" hidden>
    <div class="wide fr-sticky-in">
      <span class="fr-sticky-t">{{ section.settings.sticky_label | default: p.title }}</span>
      <span class="fr-sticky-p">{% if p %}{{ p.price | money }}{% else %}29,90 €{% endif %}</span>
      <button type="button" class="fr-atc fr-sticky-b">{{ section.settings.sticky_cta }}</button>
    </div>
  </div>
{%- endif -%}

<script>
(function(){
  var root = document.currentScript.previousElementSibling;
  // galerie : la vignette pilote la grande image
  document.querySelectorAll('.fr-gal').forEach(function(gal){
    gal.addEventListener('click', function(e){
      var t = e.target.closest('.fr-gal-thumb'); if(!t) return;
      var i = t.dataset.i;
      gal.querySelectorAll('.fr-gal-thumb').forEach(function(b){ b.classList.toggle('is-on', b===t); });
      gal.querySelectorAll('.fr-gal-slide').forEach(function(s){ s.classList.toggle('is-on', s.dataset.i===i); });
    });
  });
  // device de reconnaissance : repondre revele la ligne, ne bloque jamais l'achat
  document.querySelectorAll('.fr-reco').forEach(function(r){
    r.addEventListener('click', function(e){
      var b = e.target.closest('.fr-reco-o'); if(!b) return;
      r.querySelectorAll('.fr-reco-o').forEach(function(x){ x.classList.toggle('is-on', x===b); });
      var a = r.querySelector('.fr-reco-a'); if(a) a.hidden = false;
    });
  });
  // sticky : apparait quand l'ATC principal sort de l'ecran
  var st = document.getElementById('fr-sticky');
  var atc = document.querySelector('.fr-atc-wrap');
  if(st && atc && 'IntersectionObserver' in window){
    new IntersectionObserver(function(en){ st.hidden = en[0].isIntersecting; },
      {rootMargin:'0px 0px -60px 0px'}).observe(atc);
    st.addEventListener('click', function(e){
      if(!e.target.closest('.fr-sticky-b')) return;
      var f = document.getElementById('freos-atc-form');
      if(f) f.requestSubmit ? f.requestSubmit() : f.submit();
    });
  }
})();
</script>

{% schema %}
{
  "name": "FREOS · PDP hero",
  "tag": "section",
  "class": "freos-pdp-hero-section",
  "settings": [
    { "type": "header", "content": "Galerie" },
    {
      "type": "textarea", "id": "gallery_files", "label": "Fichiers",
      "info": "Noms des assets du theme, separes par des virgules.",
      "default": "freos-pdp-01-main.jpg,freos-pdp-03-meccanismo.jpg,freos-pdp-02-ingredienti.jpg,freos-pdp-04-howto.jpg,freos-pdp-05-scala.jpg,freos-pdp-06-obiezione.jpg,freos-pdp-07-limiti.jpg,freos-pdp-08-garanzia.jpg"
    },
    { "type": "text", "id": "gallery_alt", "label": "Texte alternatif" },
    { "type": "header", "content": "Sticky" },
    { "type": "checkbox", "id": "sticky_atc", "label": "Barre d'achat collante", "default": true },
    { "type": "text", "id": "sticky_label", "label": "Libelle" },
    { "type": "text", "id": "sticky_cta", "label": "Bouton", "default": "Aggiungi al carrello" }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Sur-titre", "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Texte" }] },
    { "type": "title", "name": "Titre", "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Titre", "info": "Vide = titre du produit" }] },
    { "type": "subtitle", "name": "Sous-titre", "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Texte" }] },
    { "type": "rating", "name": "Note", "limit": 1,
      "settings": [
        { "type": "text", "id": "score", "label": "Note" },
        { "type": "text", "id": "count", "label": "Nombre d'avis" }
      ] },
    { "type": "pills", "name": "Pastilles",
      "settings": [{ "type": "text", "id": "items", "label": "Elements", "info": "Separes par |" }] },
    { "type": "price", "name": "Prix", "limit": 1,
      "settings": [
        { "type": "text", "id": "fallback", "label": "Prix de repli", "default": "29,90 €" },
        { "type": "text", "id": "note", "label": "Note sous le prix" }
      ] },
    { "type": "benefits", "name": "Benefices",
      "settings": [{ "type": "textarea", "id": "items", "label": "Lignes", "info": "Une par ligne." }] },
    { "type": "recognition", "name": "Reconnaissance", "limit": 1,
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "options", "label": "Reponses", "info": "Une par ligne." },
        { "type": "text", "id": "answer", "label": "Ligne revelee" }
      ] },
    { "type": "buy_buttons", "name": "Bouton d'achat", "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Libelle", "default": "Aggiungi al carrello" },
        { "type": "text", "id": "soldout", "label": "Rupture", "default": "Non disponibile" },
        { "type": "text", "id": "under", "label": "Ligne sous le bouton" }
      ] },
    { "type": "badges", "name": "Reassurances",
      "settings": [{ "type": "textarea", "id": "items", "label": "Lignes", "info": "Une par ligne : Titre | Precision" }] },
    { "type": "guarantee", "name": "Garantie", "limit": 1,
      "settings": [{ "type": "richtext", "id": "text", "label": "Texte" }] }
  ],
  "presets": [{ "name": "FREOS · PDP hero" }]
}
{% endschema %}
