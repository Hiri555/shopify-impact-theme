{%- comment -%}
  ============================================================================
  FREOS · PDP 04 — FREOS · 04 Numeri
  ----------------------------------------------------------------------------
  Grands chiffres. Chacun porte sa source sous le libelle : un chiffre sans
  source est une affirmation, un chiffre source est une preuve. L'animation de
  comptage respecte prefers-reduced-motion et affiche la valeur finale si le
  JS ne tourne pas -- le chiffre est dans le HTML, pas cree par le script.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur
  dans ce fichier. Genere par build_pdp_sections.py -- modifier le generateur,
  pas ce fichier, sinon la prochaine generation ecrase la retouche.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--stats fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-stats">
      {%- for block in section.blocks -%}
        <div class="fr-stat" {{ block.shopify_attributes }}>
          <p class="fr-stat-v" data-to="{{ block.settings.value }}">
            <span class="fr-stat-n">{{ block.settings.value }}</span>
            {%- if block.settings.unit != blank -%}
              <span class="fr-stat-u">{{ block.settings.unit }}</span>
            {%- endif -%}
          </p>
          {%- if block.settings.label != blank -%}
            <p class="fr-stat-l">{{ block.settings.label }}</p>
          {%- endif -%}
          {%- if block.settings.note != blank -%}
            <p class="fr-stat-s">{{ block.settings.note }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>
<script>
(function(){
  var sec = document.getElementById('shopify-section-{{ section.id }}');
  if(!sec) return;
  var reduce = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(reduce || !('IntersectionObserver' in window)) return;   /* la valeur est deja dans le HTML */

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(!e.isIntersecting) return;
      io.unobserve(e.target);
      var span = e.target.querySelector('.fr-stat-n');
      var raw  = e.target.dataset.to || '';
      var num  = parseFloat(raw.replace(',', '.').replace(/[^0-9.\-]/g, ''));
      if(isNaN(num)) return;
      var dec = (raw.split(/[.,]/)[1] || '').length;
      var sep = raw.indexOf(',') > -1 ? ',' : '.';
      var t0 = null, dur = 900;
      function step(t){
        if(!t0) t0 = t;
        var k = Math.min(1, (t - t0)/dur);
        var v = (num * (1 - Math.pow(1 - k, 3))).toFixed(dec);
        span.textContent = dec ? v.replace('.', sep) : v;
        if(k < 1) requestAnimationFrame(step);
        else span.textContent = raw;
      }
      requestAnimationFrame(step);
    });
  }, {threshold: .4});

  sec.querySelectorAll('.fr-stat-v').forEach(function(x){ io.observe(x); });
})();
</script>
{% schema %}
{
  "name": "FREOS · 04 Numeri",
  "tag": "section",
  "class": "freos-pdp-stats",
  "settings": [
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Chiffre",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Chiffre",
          "info": "Les decimales et le separateur sont respectes."
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unite",
          "info": "%, g, ans..."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Libelle"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Source"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS · 04 Numeri"
    }
  ]
}
{% endschema %}
