{%- comment -%}
  ============================================================================
  FREOS · PDP 05 — FREOS · 05 Differenza
  ----------------------------------------------------------------------------
  Le mecanisme, et les barres de comparaison qui le rendent visible. La
  largeur de chaque barre s'anime a l'entree dans le viewport ; sans JS elle
  est deja a sa valeur, l'attribut style la porte.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur
  dans ce fichier. Genere par build_pdp_sections.py -- modifier le generateur,
  pas ce fichier, sinon la prochaine generation ecrase la retouche.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--differenza fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="fr-rt">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fr-bars">
        {%- for block in section.blocks -%}
          <div class="fr-bar{% if block.settings.accent %} is-hi{% endif %}" {{ block.shopify_attributes }}>
            <span class="fr-bar-l">{{ block.settings.label }}</span>
            <span class="fr-bar-v">{{ block.settings.meta }}</span>
            <span class="fr-bar-t"><i style="--w:{{ block.settings.value }}%"></i></span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.punch != blank -%}
      <p class="fr-punch">{{ section.settings.punch }}</p>
    {%- endif -%}

  </div>
</div>
<script>
(function(){
  var sec = document.getElementById('shopify-section-{{ section.id }}');
  if(!sec || !('IntersectionObserver' in window)) return;
  if(window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;
  var bars = sec.querySelector('.fr-bars'); if(!bars) return;
  /* is-wait met les barres a zero ; sans JS la classe n'arrive jamais et
     elles sont deja a leur largeur. On ne cache jamais une donnee. */
  bars.classList.add('is-wait');
  var io = new IntersectionObserver(function(e){
    if(e[0].isIntersecting){ bars.classList.remove('is-wait'); io.disconnect(); }
  }, {threshold:.3});
  io.observe(bars);
})();
</script>
{% schema %}
{
  "name": "FREOS · 05 Differenza",
  "tag": "section",
  "class": "freos-pdp-differenza",
  "settings": [
    {
      "type": "header",
      "content": "Corps"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "punch",
      "label": "Phrase de chute"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "bar",
      "name": "Barre",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libelle"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Precision"
        },
        {
          "type": "range",
          "id": "value",
          "label": "Valeur",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "checkbox",
          "id": "accent",
          "label": "Mettre en avant",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS · 05 Differenza"
    }
  ]
}
{% endschema %}
