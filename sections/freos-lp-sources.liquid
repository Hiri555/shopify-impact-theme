{%- comment -%}
  ============================================================================
  FREOS · LP — FREOS LP · Fonti
  ----------------------------------------------------------------------------
  Les sources scientifiques. Une source par bloc.
  Le reglage `scope` choisit la feuille (fr-lp1 / fr-lp2 / fr-lp3).
  Genere par build_lp_sections_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  <div class="fonti">
    {%- if section.settings.title != blank -%}<div class="fonti-title">{{ section.settings.title }}</div>{%- endif -%}
    <ol>
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "FREOS LP · Fonti",
  "tag": "section",
  "class": "freos-lp-sources",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Page",
      "default": "fr-lp1",
      "info": "Choisit la feuille de style appliquee. Une section deplacee d'une LP a l'autre doit changer de page ici.",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "src",
      "name": "Fonte",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Reference"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS LP · Fonti"
    }
  ]
}
{% endschema %}
