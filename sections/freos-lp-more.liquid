{%- comment -%}
  ============================================================================
  FREOS · PRELANDER — Prelander · Altro
  ----------------------------------------------------------------------------
  La liste « Altro da Ricerca » en bas d'article. Un bloc par entree :
  categorie, titre, lien.
  Tout le contenu visible est un reglage ou un bloc : rien n'est en dur.
  Genere par build_prelander.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  <div class="pl-w">
    <div class="pl-more">
      {%- if section.settings.heading != blank -%}
        <h4>{{ section.settings.heading }}</h4>
      {%- endif -%}
      <ul>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.cat != blank -%}
              <span class="pl-cat">{{ block.settings.cat }}</span>
            {%- endif -%}
            <a href="{{ block.settings.url | default: '#' }}">{{ block.settings.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Prelander · Altro",
  "tag": "section",
  "class": "freos-lp-more",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre de la liste",
      "default": "Altro da Ricerca"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Feuille de style",
      "default": "fr-lp4",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        },
        {
          "value": "fr-lp4",
          "label": "Prelander · A Bocca Chiusa"
        }
      ]
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Article",
      "settings": [
        {
          "type": "text",
          "id": "cat",
          "label": "Categorie"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "text",
          "id": "url",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prelander · Altro"
    }
  ]
}
{% endschema %}
