{%- comment -%}
  ============================================================================
  FREOS · SECTION EDITORIALE
  ----------------------------------------------------------------------------
  La piece maitresse du storefront. Chaque type de bloc correspond a un
  composant du design system LP v4 (assets/freos.css), repris tel quel et non
  reconstruit a la main.

  Elle compose la PDP (sections 1 a 8), la home, le prelander magazine et les
  pages secondaires. La copy vit dans les reglages, donc reste editable dans
  l'editeur de theme sans toucher au code.

  Tout est rendu dans .fr, le wrapper qui porte les tokens de marque.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign width_class = 'wrap'
  if section.settings.width == 'wide'
    assign width_class = 'wide'
  endif
-%}

<div
  class="fr fr-editorial fr-surface--{{ section.settings.surface }}"
  style="--fr-pad-top:{{ section.settings.padding_top }}px;--fr-pad-bottom:{{ section.settings.padding_bottom }}px;"
>
  <div class="{{ width_class }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'section_header' -%}
          <div class="sect" {{ block.shopify_attributes }}>
            {%- if block.settings.kicker != blank -%}
              <p class="k">{{ block.settings.kicker }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.dek != blank -%}
              <p>{{ block.settings.dek }}</p>
            {%- endif -%}
          </div>

        {%- when 'kicker' -%}
          <p class="chip" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

        {%- when 'heading' -%}
          <h2 class="fr-h2" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>

        {%- when 'paragraph' -%}
          <div class="fr-rt" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

        {%- when 'punch' -%}
          <p class="punch" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

        {%- when 'callout' -%}
          <div class="callout" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

        {%- when 'note' -%}
          <div class="hnote" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

        {%- when 'mirror' -%}
          <div class="mirror" {{ block.shopify_attributes }}>
            {{ block.settings.quote }}
            {%- if block.settings.source != blank -%}
              <span>{{ block.settings.source }}</span>
            {%- endif -%}
          </div>

        {%- when 'testimonial' -%}
          <div class="tst{% if block.settings.story %} story{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.quote != blank -%}
              <p class="quo">{{ block.settings.quote }}</p>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="body">{{ block.settings.body }}</div>
            {%- endif -%}
            {%- if block.settings.source != blank -%}
              <div class="sig">
                <i>{{ block.settings.source }}</i>
                {%- if block.settings.badge != blank -%}
                  <span class="verif">{{ block.settings.badge }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

        {%- when 'timeline' -%}
          <div class="tl" {{ block.shopify_attributes }}>
            {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
            {%- for row in rows -%}
              {%- assign cells = row | strip | split: '|' -%}
              {%- if cells.size >= 2 -%}
                <div class="row{% if cells[0] contains '!' %} stop{% endif %}">
                  <span class="chip">{{ cells[0] | remove: '!' | strip }}</span>
                  <div>
                    <h4>{{ cells[1] | strip }}</h4>
                    {%- if cells[2] -%}<p>{{ cells[2] | strip }}</p>{%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

        {%- when 'compare' -%}
          <div class="cmp" {{ block.shopify_attributes }}>
            {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
            {%- for row in rows -%}
              {%- assign cells = row | strip | split: '|' -%}
              {%- if cells.size >= 2 -%}
                <div class="row{% if cells[0] contains '*' %} hi{% endif %}">
                  <div class="lbl">
                    {{ cells[0] | remove: '*' | strip }}
                    {%- if cells[2] -%}<small>{{ cells[2] | strip }}</small>{%- endif -%}
                  </div>
                  <div class="val">{{ cells[1] | strip }}</div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

        {%- when 'image' -%}
          {%- if block.settings.image != blank -%}
            <figure class="fr-fig" {{ block.shopify_attributes }}>
              <div class="heroimg">
                {{
                  block.settings.image
                  | image_url: width: 1440
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800,1000,1200,1440',
                    sizes: '(max-width: 760px) 100vw, 720px',
                    alt: block.settings.image.alt
                }}
              </div>
              {%- if block.settings.caption != blank -%}
                <figcaption class="cite">{{ block.settings.caption }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}

        {%- when 'cta' -%}
          <div class="cta-wrap" {{ block.shopify_attributes }}>
            <a class="cta" href="{{ block.settings.url | default: '#' }}">
              <span>{{ block.settings.label }}</span>
              {%- if block.settings.pill != blank -%}
                <span class="pill">{{ block.settings.pill }}</span>
              {%- endif -%}
            </a>
            {%- if block.settings.reassurance != blank -%}
              <span class="guar">{{ block.settings.reassurance }}</span>
            {%- endif -%}
          </div>

        {%- when 'trust' -%}
          <div class="trust" {{ block.shopify_attributes }}>
            {%- assign items = block.settings.items | split: '|' -%}
            {%- for item in items -%}
              <div>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M3 8.5l3.2 3.2L13 5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ item | strip }}</span>
              </div>
            {%- endfor -%}
          </div>

        {%- when 'sources' -%}
          <div class="src" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.title }}</strong>
            <ol>
              {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- for item in items -%}
                {%- assign clean = item | strip -%}
                {%- if clean != blank -%}<li>{{ clean }}</li>{%- endif -%}
              {%- endfor -%}
            </ol>
          </div>

        {%- when 'faq' -%}
          <details class="fr-faq-item"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="fr-faq-answer">{{ block.settings.answer }}</div>
          </details>

        {%- when 'doors' -%}
          <div class="fr-doors" {{ block.shopify_attributes }}>
            {%- assign doors = block.settings.doors | newline_to_br | split: '<br />' -%}
            {%- for d in doors -%}
              {%- assign c = d | strip | split: '|' -%}
              {%- if c.size >= 3 -%}
                <a class="fr-door" href="{{ c[3] | default: '#' | strip }}">
                  <span class="fr-door-t">{{ c[0] | strip }}</span>
                  <span class="fr-door-d">{{ c[1] | strip }}</span>
                  <span class="fr-door-l">{{ c[2] | strip }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>

        {%- when 'newsletter' -%}
          <div class="fr-news" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <p class="fr-news-h">{{ block.settings.heading }}</p>
            {%- endif -%}
            {%- form 'customer', class: 'fr-news-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="fr-news-lbl" for="fr-news-email">{{ block.settings.label }}</label>
              <div class="fr-news-row">
                <input id="fr-news-email" type="email" name="contact[email]"
                       placeholder="{{ block.settings.placeholder }}" required>
                <button type="submit">{{ block.settings.button }}</button>
              </div>
              {%- if form.posted_successfully? -%}
                <p class="fr-news-ok">{{ block.settings.success }}</p>
              {%- endif -%}
              {%- if form.errors -%}
                <p class="fr-news-err">{{ form.errors | default_errors }}</p>
              {%- endif -%}
            {%- endform -%}
            {%- if block.settings.consent != blank -%}
              <p class="fr-news-consent">{{ block.settings.consent }}</p>
            {%- endif -%}
          </div>

        {%- when 'divider' -%}
          <div class="fr-divider" {{ block.shopify_attributes }}></div>

        {%- when 'custom' -%}
          <div class="fr-custom" {{ block.shopify_attributes }}>{{ block.settings.code }}</div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS · Editorial",
  "tag": "section",
  "class": "freos-editorial-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "options": [
        { "value": "white", "label": "Blanc" },
        { "value": "softer", "label": "Creme clair" },
        { "value": "soft", "label": "Creme" },
        { "value": "ink", "label": "Encre (sombre)" }
      ],
      "default": "white"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "options": [
        { "value": "narrow", "label": "Colonne 720px" },
        { "value": "wide", "label": "Large (920px)" }
      ],
      "default": "narrow"
    },
    { "type": "range", "id": "padding_top", "label": "Espace au-dessus", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Espace en dessous", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "section_header",
      "name": "Titre de section",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Sur-titre" },
        { "type": "text", "id": "heading", "label": "Titre" },
        { "type": "text", "id": "dek", "label": "Chapeau" }
      ]
    },
    {
      "type": "kicker",
      "name": "Sur-titre (chip)",
      "settings": [{ "type": "text", "id": "text", "label": "Texte" }]
    },
    {
      "type": "heading",
      "name": "Titre",
      "settings": [{ "type": "text", "id": "text", "label": "Titre" }]
    },
    {
      "type": "paragraph",
      "name": "Paragraphe",
      "settings": [{ "type": "richtext", "id": "text", "label": "Texte" }]
    },
    {
      "type": "punch",
      "name": "Phrase de chute",
      "settings": [{ "type": "text", "id": "text", "label": "Texte" }]
    },
    {
      "type": "callout",
      "name": "Encadre vert",
      "settings": [{ "type": "richtext", "id": "text", "label": "Texte" }]
    },
    {
      "type": "note",
      "name": "Note (filet vert)",
      "settings": [{ "type": "richtext", "id": "text", "label": "Texte" }]
    },
    {
      "type": "mirror",
      "name": "Leurs mots",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Citation" },
        { "type": "text", "id": "source", "label": "Source" }
      ]
    },
    {
      "type": "testimonial",
      "name": "Carte citation",
      "settings": [
        { "type": "text", "id": "quote", "label": "Accroche" },
        { "type": "richtext", "id": "body", "label": "Corps" },
        { "type": "text", "id": "source", "label": "Source" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "checkbox", "id": "story", "label": "Format long", "default": false }
      ]
    },
    {
      "type": "timeline",
      "name": "Timeline",
      "settings": [
        {
          "type": "textarea",
          "id": "rows",
          "label": "Lignes",
          "info": "Une ligne par etape : Libelle | Titre | Texte. Prefixer le libelle par ! pour la variante d'alerte."
        }
      ]
    },
    {
      "type": "compare",
      "name": "Tableau comparatif",
      "settings": [
        {
          "type": "textarea",
          "id": "rows",
          "label": "Lignes",
          "info": "Une ligne par entree : Libelle | Valeur | Precision. Prefixer le libelle par * pour surligner."
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Legende" }
      ]
    },
    {
      "type": "cta",
      "name": "Bouton",
      "settings": [
        { "type": "text", "id": "label", "label": "Libelle" },
        { "type": "text", "id": "pill", "label": "Pastille" },
        { "type": "text", "id": "url", "label": "Lien", "info": "URL ou chemin (/products/...). Accepte un placeholder tant que la destination n'existe pas." },
        { "type": "text", "id": "reassurance", "label": "Ligne de reassurance" }
      ]
    },
    {
      "type": "trust",
      "name": "Bandeau reassurance",
      "settings": [
        { "type": "textarea", "id": "items", "label": "Elements", "info": "Separes par une barre verticale |" }
      ]
    },
    {
      "type": "sources",
      "name": "Sources",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Fonti" },
        { "type": "textarea", "id": "items", "label": "Sources", "info": "Une par ligne." }
      ]
    },
    {
      "type": "faq",
      "name": "Question FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Reponse" },
        { "type": "checkbox", "id": "open", "label": "Ouverte par defaut", "default": false }
      ]
    },
    {
      "type": "doors",
      "name": "Routeur (portes)",
      "settings": [
        {
          "type": "textarea",
          "id": "doors",
          "label": "Portes",
          "info": "Une par ligne : Titre | Description | Libelle du lien | URL"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Capture e-mail",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre" },
        { "type": "text", "id": "label", "label": "Libelle du champ" },
        { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "La tua email" },
        { "type": "text", "id": "button", "label": "Bouton", "default": "Iscriviti" },
        { "type": "text", "id": "success", "label": "Message de succes" },
        { "type": "richtext", "id": "consent", "label": "Mention de consentement" }
      ]
    },
    { "type": "divider", "name": "Filet" },
    {
      "type": "custom",
      "name": "HTML libre",
      "settings": [{ "type": "html", "id": "code", "label": "Code" }]
    }
  ],
  "presets": [{ "name": "FREOS · Editorial" }]
}
{% endschema %}
