{%- comment -%}
  ============================================================================
  FREOS · LP — FREOS LP · Costi
  ----------------------------------------------------------------------------
  L'ancrage de cout, et le CTA du milieu de page.

  Le CTA n'apparait que si son libelle est rempli : une page ne doit porter
  aucun appel a l'action avant la revelation du produit.
  Le reglage `scope` choisit la feuille (fr-lp1 / fr-lp2 / fr-lp3).
  Genere par build_lp_sections_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}{% unless section.settings.rule %} no-rule{% endunless %}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
{%- if section.settings.kicker != blank -%}<p class="k">{{ section.settings.kicker }}</p>{%- endif -%}  <div class="anc">
    {%- if section.settings.heading != blank -%}<h3>{{ section.settings.heading }}</h3>{%- endif -%}
    {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead }}</p>{%- endif -%}

    {%- for block in section.blocks -%}
      <div class="anc-r{% if block.settings.us %} us{% endif %}" {{ block.shopify_attributes }}>
        <div class="anc-l">{{ block.settings.label }}
          {%- if block.settings.detail != blank -%}<small>{{ block.settings.detail }}</small>{%- endif -%}
        </div>
        <div class="anc-v">{{ block.settings.value }}</div>
      </div>
    {%- endfor -%}

    {%- if section.settings.note != blank -%}<p class="anc-note">{{ section.settings.note }}</p>{%- endif -%}
    {%- if section.settings.source != blank -%}<p class="anc-src">{{ section.settings.source }}</p>{%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="cta-mid">
        <a href="{{ section.settings.cta_url | default: '/' }}">{{ section.settings.cta_label }}</a>
        {%- if section.settings.cta_sub != blank -%}<p>{{ section.settings.cta_sub }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS LP · Costi",
  "tag": "section",
  "class": "freos-lp-anchor",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "info": "La petite ligne au-dessus du titre. Vide = rien."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre du bloc"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Chapeau"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "textarea",
      "id": "source",
      "label": "Sources"
    },
    {
      "type": "header",
      "content": "Bouton du milieu"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Libelle",
      "info": "Vide = aucun bouton. Ne rien mettre avant la revelation du produit."
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Lien"
    },
    {
      "type": "textarea",
      "id": "cta_sub",
      "label": "Ligne sous le bouton"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Page",
      "default": "fr-lp1",
      "info": "Choisit la feuille de style appliquee. Une section deplacee d'une LP a l'autre doit changer de page ici.",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "checkbox",
      "id": "rule",
      "label": "Filet de separation au-dessus",
      "info": "A decocher sur la premiere partie de l'article.",
      "default": true
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Riga di costo",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libelle"
        },
        {
          "type": "textarea",
          "id": "detail",
          "label": "Precision"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Montant"
        },
        {
          "type": "checkbox",
          "id": "us",
          "label": "C'est notre ligne",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS LP · Costi"
    }
  ]
}
{% endschema %}
