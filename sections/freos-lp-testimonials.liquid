{%- comment -%}
  ============================================================================
  FREOS · LP — FREOS LP · Voci
  ----------------------------------------------------------------------------
  Les temoignages. Un bloc par temoignage, et UN richtext pour tout son corps
  -- pas un reglage par paragraphe : ca garde le schema lisible et reste sous
  la limite de 50 blocs.
  Le reglage `scope` choisit la feuille (fr-lp1 / fr-lp2 / fr-lp3).
  Genere par build_lp_sections_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  <div class="ps">
    {%- if section.settings.heading != blank -%}<h3>{{ section.settings.heading }}</h3>{%- endif -%}
    {%- if section.settings.sub != blank -%}<p class="psub">{{ section.settings.sub }}</p>{%- endif -%}

    {%- for block in section.blocks -%}
      <div class="tst{% if block.settings.story %} story{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.obj_head != blank -%}
          <p class="obj-head">{{ block.settings.obj_head }}</p>
        {%- endif -%}
        {%- if block.settings.obj_tag != blank -%}
          <p class="obj-tag">{{ block.settings.obj_tag }}</p>
        {%- endif -%}
        {%- if block.settings.quote != blank -%}
          <p class="quo">{{ block.settings.quote }}</p>
        {%- endif -%}
        <div class="body">{{ block.settings.body }}</div>
        <div class="sig">
          <b>{{ block.settings.name }}</b>
          {%- if block.settings.role != blank -%}<i>·</i><span class="role">{{ block.settings.role }}</span>{%- endif -%}
          {%- if block.settings.badge != blank -%}<i>·</i><span class="verif">{{ block.settings.badge }}</span>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS LP · Voci",
  "tag": "section",
  "class": "freos-lp-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre du bloc"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Sous-titre"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Page",
      "default": "fr-lp1",
      "info": "Choisit la feuille de style appliquee. Une section deplacee d'une LP a l'autre doit changer de page ici.",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "tst",
      "name": "Voce",
      "settings": [
        {
          "type": "checkbox",
          "id": "story",
          "label": "Recit long",
          "default": false
        },
        {
          "type": "text",
          "id": "obj_head",
          "label": "Objection"
        },
        {
          "type": "text",
          "id": "obj_tag",
          "label": "Etiquette d'objection"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Citation d'accroche"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Corps du temoignage"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Qualite"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Mention",
          "default": "Verificato"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS LP · Voci"
    }
  ]
}
{% endschema %}
