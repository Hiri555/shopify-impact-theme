{%- comment -%}
  ============================================================================
  FREOS · LP — FREOS LP · Anelli
  ----------------------------------------------------------------------------
  Les anneaux de la chaine, numerotes, dans un encadre.

  LE NOMBRE ANNONCE PEUT DEPASSER LE NOMBRE MONTRE, expres : la page annonce
  cinq anneaux et en montre quatre, le cinquieme est la revelation. Le titre et
  le sous-titre sont donc du texte libre, jamais un compteur.
  Le reglage `scope` choisit la feuille (fr-lp1 / fr-lp2 / fr-lp3 / fr-lp4).
  Genere par build_lp_sections_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}{% unless section.settings.rule %} no-rule{% endunless %}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
{%- if section.settings.kicker != blank -%}<p class="k">{{ section.settings.kicker }}</p>{%- endif -%}  <div class="cycle">
    {%- if section.settings.heading != blank -%}<h3>{{ section.settings.heading }}</h3>{%- endif -%}
    {%- if section.settings.sub != blank -%}<p class="sub">{{ section.settings.sub }}</p>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ol>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}<b>{{ block.settings.title }}</b>{%- endif -%}
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
    {%- if section.settings.foot != blank -%}<p class="cycle-f">{{ section.settings.foot }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS LP · Anelli",
  "tag": "section",
  "class": "freos-lp-cycle",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "info": "La petite ligne au-dessus du titre. Vide = rien."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre de l'encadre"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Sous-titre",
      "info": "Texte libre. Il peut annoncer plus d'anneaux qu'il n'en est montre."
    },
    {
      "type": "textarea",
      "id": "foot",
      "label": "Ligne de bas d'encadre"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Page",
      "default": "fr-lp1",
      "info": "Choisit la feuille de style appliquee. Une section deplacee d'une LP a l'autre doit changer de page ici.",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        },
        {
          "value": "fr-lp4",
          "label": "Prelander · A Bocca Chiusa"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "checkbox",
      "id": "rule",
      "label": "Filet de separation au-dessus",
      "info": "A decocher sur la premiere partie de l'article.",
      "default": true
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "anello",
      "name": "Anello",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nom de l'anneau"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Ce qu'il est, en une ligne"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS LP · Anelli"
    }
  ]
}
{% endschema %}
