{%- comment -%}
  ============================================================================
  FREOS · FOOTER — version simple
  ----------------------------------------------------------------------------
  Decision du proprietaire (24/09) : PAS de bloc d'identite societe ici.
  Raison sociale, adresse, reference fiscale et e-mails vivent dans les pages
  legales, ou ils restent accessibles en permanence.

  Restent ici, parce que ce sont des obligations produit et consommateur :
  les avertissements complement alimentaire, l'avertissement the vert, et le
  lien ODR. Taille minimale 12,5 px, comme l'exige la spec.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-footer">
  <div class="wide">

    {%- if section.settings.show_newsletter -%}
      <div class="fr-footer-news">
        <p class="fr-footer-k">{{ section.settings.news_kicker }}</p>
        <p class="fr-footer-news-line">{{ section.settings.news_line }}</p>
        {%- form 'customer', class: 'fr-footer-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="fr-footer-email">{{ section.settings.news_placeholder }}</label>
          <div class="fr-news-row">
            <input id="fr-footer-email" type="email" name="contact[email]"
                   placeholder="{{ section.settings.news_placeholder }}" required>
            <button type="submit">{{ section.settings.news_button }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="fr-news-ok">{{ section.settings.news_success }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="fr-news-err">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endform -%}
        <p class="fr-footer-consent">{{ section.settings.news_consent }}</p>
      </div>
    {%- endif -%}

    <div class="fr-footer-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <nav class="fr-footer-col" {{ block.shopify_attributes }}>
            <p class="fr-footer-k">{{ block.settings.title }}</p>
            {%- assign links = block.settings.links | newline_to_br | split: '<br />' -%}
            {%- for l in links -%}
              {%- assign c = l | strip | split: '|' -%}
              {%- if c.size >= 1 and c[0] != blank -%}
                <a href="{{ c[1] | default: '#' | strip }}">{{ c[0] | strip }}</a>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="fr-footer-legal">
      <p class="fr-footer-warn">{{ section.settings.avvertenze_integratore }}</p>

      {%- if section.settings.avvertenze_te_verde != blank -%}
        <p class="fr-footer-warn">{{ section.settings.avvertenze_te_verde }}</p>
      {%- endif -%}

      <p class="fr-footer-odr">
        {{ section.settings.odr_text }}
        <a href="{{ section.settings.odr_url }}" rel="noopener" target="_blank">{{ section.settings.odr_url }}</a>
      </p>

      <p class="fr-footer-copy">{{ section.settings.copyright }}</p>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "FREOS · Footer",
  "tag": "footer",
  "class": "freos-footer-section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Afficher", "default": true },
    { "type": "text", "id": "news_kicker", "label": "Sur-titre", "default": "Resta aggiornato" },
    { "type": "text", "id": "news_line", "label": "Phrase", "default": "Ti scriviamo quando c’è qualcosa di utile da leggere. Niente altro." },
    { "type": "text", "id": "news_placeholder", "label": "Placeholder", "default": "La tua email" },
    { "type": "text", "id": "news_button", "label": "Bouton", "default": "Iscriviti" },
    { "type": "text", "id": "news_success", "label": "Succes", "default": "Fatto. Ti abbiamo aggiunto alla lista." },
    { "type": "richtext", "id": "news_consent", "label": "Consentement" },

    { "type": "header", "content": "Mentions obligatoires" },
    { "type": "textarea", "id": "avvertenze_integratore", "label": "Avertissements complement",
      "default": "Integratore alimentare. Gli integratori non sostituiscono una dieta variata ed equilibrata e uno stile di vita sano. Non superare la dose giornaliera consigliata. Tenere fuori dalla portata dei bambini al di sotto dei tre anni. Non indicato ai minori di 18 anni, in gravidanza e durante l’allattamento." },
    { "type": "textarea", "id": "avvertenze_te_verde", "label": "Avertissement the vert",
      "default": "Contiene estratto di tè verde. Non assumere in gravidanza, durante l’allattamento e sotto i 18 anni. Non a stomaco vuoto. In caso di patologie epatiche o assunzione di farmaci, consultare il medico." },
    { "type": "text", "id": "odr_text", "label": "Texte ODR",
      "default": "Risoluzione online delle controversie:" },
    { "type": "text", "id": "odr_url", "label": "URL ODR", "default": "https://ec.europa.eu/consumers/odr" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© FREOS" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Colonne de liens",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "links", "label": "Liens", "info": "Une par ligne : Libelle | URL" }
      ]
    }
  ],
  "presets": [{ "name": "FREOS · Footer" }]
}
{% endschema %}
