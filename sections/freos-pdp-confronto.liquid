{%- comment -%}
  ============================================================================
  FREOS · PDP 09 — FREOS · 09 Confronto
  ----------------------------------------------------------------------------
  Tableau comparatif. La ligne mise en avant se coche, elle ne se marque
  plus par une etoile en debut de texte -- une convention invisible qui se
  perdait au premier copier-coller.

  Sous 640 px le tableau cesse d'etre un tableau : chaque ligne devient un
  bloc empile, l'intitule de colonne repris en etiquette par cellule (data-l).
  Un tableau a trois colonnes sur 390 px se balaye lateralement, et 90 % du
  trafic est mobile.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur
  dans ce fichier. Genere par build_pdp_sections.py -- modifier le generateur,
  pas ce fichier, sinon la prochaine generation ecrase la retouche.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--confronto fr-pdp--tbl fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-cmp-wrap">
      <table class="fr-cmp">
        {%- if section.settings.col1 != blank or section.settings.col2 != blank -%}
          <thead>
            <tr>
              <th scope="col"><span class="fr-sr">Gesto</span></th>
              <th scope="col">{{ section.settings.col1 }}</th>
              <th scope="col">{{ section.settings.col2 }}</th>
            </tr>
          </thead>
        {%- endif -%}
        <tbody>
          {%- for block in section.blocks -%}
            <tr class="{% if block.settings.accent %}is-acc{% endif %}" {{ block.shopify_attributes }}>
              <th scope="row">
                <span class="fr-cmp-m" aria-hidden="true">
                  {%- if block.settings.accent -%}
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.3 6.4 12 13 4.5"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/></svg>
                  {%- endif -%}
                </span>
                {{ block.settings.label }}
              </th>
              <td{% if section.settings.col1 != blank %} data-l="{{ section.settings.col1 | escape }}"{% endif %}>{{ block.settings.c1 }}</td>
              <td{% if section.settings.col2 != blank %} data-l="{{ section.settings.col2 | escape }}"{% endif %}>{{ block.settings.c2 }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "FREOS · 09 Confronto",
  "tag": "section",
  "class": "freos-pdp-confronto",
  "settings": [
    {
      "type": "header",
      "content": "Colonnes"
    },
    {
      "type": "text",
      "id": "col1",
      "label": "Titre colonne 1"
    },
    {
      "type": "text",
      "id": "col2",
      "label": "Titre colonne 2"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libelle"
        },
        {
          "type": "text",
          "id": "c1",
          "label": "Colonne 1"
        },
        {
          "type": "text",
          "id": "c2",
          "label": "Colonne 2"
        },
        {
          "type": "checkbox",
          "id": "accent",
          "label": "Mettre en avant",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS · 09 Confronto"
    }
  ]
}
{% endschema %}
