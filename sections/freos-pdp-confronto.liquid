{%- comment -%}
  ============================================================================
  FREOS · PDP — FREOS · 07 Confronto
  ----------------------------------------------------------------------------
  Un tableau comparatif a cinq colonnes. Le libelle du critere est fige a
  gauche : a 390 px le tableau defile, et sans lui « si » tout seul ne veut
  rien dire. FREOS est la premiere colonne produit, donc visible au repos.
  Une cellule qui vaut « si » ou « no » devient une icone ; sinon le texte
  s'affiche tel quel. Une colonne dont le titre est vide disparait.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur.
  Genere par build_pdp_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--confronto fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-cmp-wrap">
      <table class="fr-cmp">
        <thead>
          <tr>
            <td class="fr-cmp-corner"></td>
            {%- for i in (1..5) -%}
              {%- case i -%}
                {%- when 1 -%}{%- assign t = section.settings.h0 -%}{%- assign im = section.settings.i0 -%}
                {%- when 2 -%}{%- assign t = section.settings.h1 -%}{%- assign im = section.settings.i1 -%}
                {%- when 3 -%}{%- assign t = section.settings.h2 -%}{%- assign im = section.settings.i2 -%}
                {%- when 4 -%}{%- assign t = section.settings.h3 -%}{%- assign im = section.settings.i3 -%}
                {%- when 5 -%}{%- assign t = section.settings.h4 -%}{%- assign im = section.settings.i4 -%}
              {%- endcase -%}
              {%- if t != blank -%}
                <th scope="col" class="fr-cmp-h{% if i == 1 %} fr-cmp-h--nous{% endif %}">
                  {%- if im != blank -%}
                    <span class="fr-cmp-ph"><img src="{{ im | strip | asset_url }}"
                         alt="{{ t | escape }}" loading="lazy"></span>
                  {%- endif -%}
                  <span class="fr-cmp-hn">{{ t }}</span>
                </th>
              {%- endif -%}
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row" class="fr-cmp-l">{{ block.settings.label }}</th>
              {%- for i in (1..5) -%}
                {%- case i -%}
                  {%- when 1 -%}{%- assign t = section.settings.h0 -%}{%- assign v = block.settings.v0 -%}
                  {%- when 2 -%}{%- assign t = section.settings.h1 -%}{%- assign v = block.settings.v1 -%}
                  {%- when 3 -%}{%- assign t = section.settings.h2 -%}{%- assign v = block.settings.v2 -%}
                  {%- when 4 -%}{%- assign t = section.settings.h3 -%}{%- assign v = block.settings.v3 -%}
                  {%- when 5 -%}{%- assign t = section.settings.h4 -%}{%- assign v = block.settings.v4 -%}
                {%- endcase -%}
                {%- if t != blank -%}
                  {%- assign vv = v | strip | downcase -%}
                  <td class="fr-cmp-c{% if i == 1 %} fr-cmp-c--nous{% endif %}">
                    {%- if vv == 'si' -%}
                      <span class="fr-cmp-oui" aria-label="si"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    {%- elsif vv == 'no' -%}
                      <span class="fr-cmp-non" aria-label="no"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round"/></svg></span>
                    {%- else -%}
                      {{ v }}
                    {%- endif -%}
                  </td>
                {%- endif -%}
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    <p class="fr-rail-hint" aria-hidden="true">Scorri &#8594;</p>

    {%- if section.settings.note != blank -%}
      <div class="fr-vs-note">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

