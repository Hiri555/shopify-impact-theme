{%- comment -%}
  ============================================================================
  FREOS · PDP — FREOS · 07 Confronto
  ----------------------------------------------------------------------------
  Deux colonnes face a face, une pastille « vs » sur l'axe. A gauche la
  solution deja essayee, en gris ; a droite FREOS, mis en valeur. Chaque
  ligne est un bloc : le libelle, puis les deux reponses l'une en face de
  l'autre.
  A 390 px les colonnes s'empilent et le « vs » passe entre les deux.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur.
  Genere par build_pdp_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--confronto fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-vs">
      <div class="fr-vs-col fr-vs-col--a">
        <div class="fr-vs-head">
          {%- if section.settings.img1 != blank -%}
            <span class="fr-vs-ph"><img src="{{ section.settings.img1 | strip | asset_url }}"
                 alt="{{ section.settings.col1 | escape }}" loading="lazy"></span>
          {%- endif -%}
          <p class="fr-vs-t">{{ section.settings.col1 }}</p>
        </div>
        <dl class="fr-vs-rows">
          {%- for block in section.blocks -%}
            <div class="fr-vs-row" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label }}</dt>
              <dd>{{ block.settings.c1 }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      </div>

      <span class="fr-vs-badge" aria-hidden="true">vs</span>

      <div class="fr-vs-col fr-vs-col--b">
        <div class="fr-vs-head">
          {%- if section.settings.img2 != blank -%}
            <span class="fr-vs-ph"><img src="{{ section.settings.img2 | strip | asset_url }}"
                 alt="{{ section.settings.col2 | escape }}" loading="lazy"></span>
          {%- endif -%}
          <p class="fr-vs-t">{{ section.settings.col2 }}</p>
        </div>
        <dl class="fr-vs-rows">
          {%- for block in section.blocks -%}
            <div class="fr-vs-row" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label }}</dt>
              <dd>{{ block.settings.c2 }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      </div>
    </div>

    {%- if section.settings.note != blank -%}
      <div class="fr-vs-note">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS · 07 Confronto",
  "tag": "section",
  "class": "freos-pdp-confronto",
  "settings": [
    {
      "type": "header",
      "content": "Les deux colonnes"
    },
    {
      "type": "text",
      "id": "col1",
      "label": "Titre de gauche"
    },
    {
      "type": "text",
      "id": "img1",
      "label": "Vignette de gauche (asset)"
    },
    {
      "type": "text",
      "id": "col2",
      "label": "Titre de droite"
    },
    {
      "type": "text",
      "id": "img2",
      "label": "Vignette de droite (asset)"
    },
    {
      "type": "header",
      "content": "Bas de section"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "wide",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libelle"
        },
        {
          "type": "textarea",
          "id": "c1",
          "label": "Colonne de gauche"
        },
        {
          "type": "textarea",
          "id": "c2",
          "label": "Colonne de droite"
        }
      ]
    }
  ]
}
{% endschema %}
