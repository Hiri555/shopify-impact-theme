{%- comment -%}
  ============================================================================
  FREOS · PRELANDER — Prelander · Barre
  ----------------------------------------------------------------------------
  La barre de marque, les rubriques, et le fil d'Ariane. Chaque entree est
  un bloc : on en ajoute, on en retire, on les reordonne.
  Les liens sont inertes par defaut -- c'est un prelander, pas un magazine.
  Tout le contenu visible est un reglage ou un bloc : rien n'est en dur.
  Genere par build_prelander.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  <div class="pl-topbar">
    <div class="pl-w">
      <a class="pl-logo" href="{{ section.settings.logo_url | default: '#' }}">
        {{ section.settings.logo }}</a>
      <nav class="pl-nav">
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav' -%}
            <a href="{{ block.settings.url | default: '#' }}"
               class="{% if block.settings.on %}on{% endif %}"
               {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
      <svg class="pl-srch" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    </div>
  </div>

  {%- assign nsub = 0 -%}
  {%- for block in section.blocks -%}{%- if block.type == 'sub' -%}{%- assign nsub = nsub | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if nsub > 0 -%}
    <div class="pl-subnav">
      <div class="pl-w">
        {%- for block in section.blocks -%}
          {%- if block.type == 'sub' -%}
            <a href="{{ block.settings.url | default: '#' }}"
               class="{% if block.settings.on %}on{% endif %}"
               {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.crumb != blank -%}
    <div class="pl-w"><p class="pl-crumb">{{ section.settings.crumb }}</p></div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Prelander · Barre",
  "tag": "section",
  "class": "freos-lp-topbar",
  "settings": [
    {
      "type": "text",
      "id": "logo",
      "label": "Nom du titre",
      "info": "<em>...</em> met un fragment en vert italique.",
      "default": "A Bocca <em>Chiusa</em>"
    },
    {
      "type": "text",
      "id": "logo_url",
      "label": "Lien du titre"
    },
    {
      "type": "text",
      "id": "crumb",
      "label": "Fil d'Ariane",
      "info": "HTML simple accepte."
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Feuille de style",
      "default": "fr-lp4",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        },
        {
          "value": "fr-lp4",
          "label": "Prelander · A Bocca Chiusa"
        }
      ]
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "nav",
      "name": "Rubrique",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libelle"
        },
        {
          "type": "text",
          "id": "url",
          "label": "Lien"
        },
        {
          "type": "checkbox",
          "id": "on",
          "label": "Rubrique active",
          "default": false
        }
      ]
    },
    {
      "type": "sub",
      "name": "Sous-rubrique",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libelle"
        },
        {
          "type": "text",
          "id": "url",
          "label": "Lien"
        },
        {
          "type": "checkbox",
          "id": "on",
          "label": "Active",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prelander · Barre"
    }
  ]
}
{% endschema %}
