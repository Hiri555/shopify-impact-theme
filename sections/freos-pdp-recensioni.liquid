{%- comment -%}
  ============================================================================
  FREOS · PDP — FREOS · 08 Recensioni
  ----------------------------------------------------------------------------
  Un rail qui defile, une carte par recit.

  NI VISAGE, NI PRENOM, NI AGE, NI ETOILE -- et ce n'est pas un reglage laisse
  vide, c'est une capacite retiree du gabarit. Le produit est cree le 24
  septembre : il n'a aucun client, donc tout nom, tout age, tout « avant /
  apres » attribue a quelqu'un serait un faux temoignage, et toute note
  chiffree une note inventee.

  Ce qui reste est ce qu'on a le droit de montrer : des recits recueillis
  pendant l'enquete, anonymes, raccourcis, annonces comme tels par la ligne de
  provenance en bas de section. Les vrais avis viendront quand il y aura de
  vrais clients -- ils auront leur propre bloc, alimente par l'application
  d'avis, pas par ce gabarit.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur.
  Genere par build_pdp_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--recensioni fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-rail fr-rail--rev" role="list">
      {%- for block in section.blocks -%}
        <article class="fr-rcard fr-rcard--nu" role="listitem" {{ block.shopify_attributes }}>
          <div class="fr-rcard-b">
            {%- if block.settings.title != blank -%}
              <h3 class="fr-rcard-t">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="fr-rcard-x">{{ block.settings.body }}</div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    <p class="fr-rail-hint" aria-hidden="true">Scorri &#8594;</p>

    {%- if section.settings.source != blank -%}
      <p class="fr-reviews-src">{{ section.settings.source }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS · 08 Recensioni",
  "tag": "section",
  "class": "freos-pdp-recensioni",
  "settings": [
    {
      "type": "header",
      "content": "Bas de section"
    },
    {
      "type": "text",
      "id": "source",
      "label": "Mention de provenance"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "wide",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Racconto anonimo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre du recit",
          "info": "Une phrase courte. Jamais un resultat attribue a quelqu'un."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Recit"
        }
      ]
    }
  ]
}
{% endschema %}
