{%- comment -%}
  ============================================================================
  FREOS · PDP — FREOS · 08 Recensioni
  ----------------------------------------------------------------------------
  Un rail qui defile, une carte par recit. L'image est une SCENE du soir,
  pas un portrait : decision du proprietaire, pas de faux clients generes.
  Aucune note globale ici -- le « 4,8 sur 126 recensioni » etait invente, et
  les advertorials disent eux-memes qu'il n'y a pas encore d'avis verifies.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur.
  Genere par build_pdp_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--recensioni fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-rail fr-rail--rev" role="list">
      {%- for block in section.blocks -%}
        <article class="fr-rcard" role="listitem" {{ block.shopify_attributes }}>
          <span class="fr-rcard-ph">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                   widths: '320,520,800', sizes: '(max-width:860px) 78vw, 300px',
                   alt: block.settings.name, class: 'fr-rcard-img', loading: 'lazy' }}
            {%- elsif block.settings.file != blank -%}
              <img class="fr-rcard-img" src="{{ block.settings.file | strip | asset_url }}"
                   alt="{{ block.settings.name | escape }}" loading="lazy">
            {%- endif -%}
          </span>
          <div class="fr-rcard-b">
            {%- assign n = block.settings.stars | times: 1 -%}
            {%- if n > 0 -%}
              <span class="fr-rcard-s" aria-label="{{ n }}/5">
                {%- for i in (1..n) -%}
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6z"/></svg>
                {%- endfor -%}
              </span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="fr-rcard-t">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="fr-rcard-x">{{ block.settings.body }}</div>
            {%- endif -%}
            <footer class="fr-rcard-f">
              <b>{{ block.settings.name }}</b>
              {%- if block.settings.age != blank -%}
                <span>&middot; {{ block.settings.age }}</span>
              {%- endif -%}
              {%- if block.settings.durata != blank -%}
                <span>&middot; {{ block.settings.durata }}</span>
              {%- endif -%}
            </footer>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <p class="fr-rail-hint" aria-hidden="true">Scorri &#8594;</p>

    {%- if section.settings.source != blank -%}
      <p class="fr-reviews-src">{{ section.settings.source }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS · 08 Recensioni",
  "tag": "section",
  "class": "freos-pdp-recensioni",
  "settings": [
    {
      "type": "header",
      "content": "Bas de section"
    },
    {
      "type": "text",
      "id": "source",
      "label": "Mention de provenance"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "wide",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Racconto",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo de scene"
        },
        {
          "type": "text",
          "id": "file",
          "label": "Ou : asset du theme"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Prenom"
        },
        {
          "type": "text",
          "id": "age",
          "label": "Age"
        },
        {
          "type": "text",
          "id": "durata",
          "label": "Depuis combien de temps"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Etoiles",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre du recit"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Recit"
        }
      ]
    }
  ]
}
{% endschema %}
