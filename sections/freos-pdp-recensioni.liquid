{%- comment -%}
  ============================================================================
  FREOS · PDP 10 — FREOS · 10 Recensioni
  ----------------------------------------------------------------------------
  Avis. Pas de fausse photo de client : une initiale sur pastille, ce qui
  est honnete et ce que fait la reference. Le badge « verifie » est un champ
  libre, pas une affirmation codee en dur.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur
  dans ce fichier. Genere par build_pdp_sections.py -- modifier le generateur,
  pas ce fichier, sinon la prochaine generation ecrase la retouche.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--recensioni fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    {%- if section.settings.score != blank -%}
      <div class="fr-reviews-head">
        <span class="fr-rate-stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6z"/></svg>
          {%- endfor -%}
        </span>
        <b>{{ section.settings.score }}</b>
        <span>{{ section.settings.count }}</span>
        {%- if section.settings.source != blank -%}
          <span class="fr-reviews-src">{{ section.settings.source }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="fr-reviews-grid">
      {%- for block in section.blocks -%}
        <article class="fr-review" {{ block.shopify_attributes }}>
          <span class="fr-rate-stars" aria-label="{{ block.settings.stars }}/5">
            {%- for i in (1..5) -%}
              <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"
                   fill="{% if forloop.index <= block.settings.stars %}currentColor{% else %}none{% endif %}"
                   stroke="currentColor" stroke-width="1.1"><path d="M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6z"/></svg>
            {%- endfor -%}
          </span>
          {%- if block.settings.title != blank -%}
            <h3 class="fr-review-t">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <p class="fr-review-b">{{ block.settings.body }}</p>
          {%- endif -%}
          <footer class="fr-review-f">
            <span class="fr-review-av" aria-hidden="true">{{ block.settings.name | strip | slice: 0 }}</span>
            <span class="fr-review-n">{{ block.settings.name }}</span>
            {%- if block.settings.badge != blank -%}
              <span class="fr-review-vb">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.3 6.4 12 13 4.5"/></svg>
                {{- block.settings.badge -}}
              </span>
            {%- endif -%}
            {%- if block.settings.date != blank -%}
              <span class="fr-review-d">{{ block.settings.date }}</span>
            {%- endif -%}
          </footer>
        </article>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "FREOS · 10 Recensioni",
  "tag": "section",
  "class": "freos-pdp-recensioni",
  "settings": [
    {
      "type": "header",
      "content": "Note agregee"
    },
    {
      "type": "text",
      "id": "score",
      "label": "Note"
    },
    {
      "type": "text",
      "id": "count",
      "label": "Nombre d'avis"
    },
    {
      "type": "text",
      "id": "source",
      "label": "Mention de source"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nom"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Etoiles",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Texte"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS · 10 Recensioni"
    }
  ]
}
{% endschema %}
