{%- comment -%}
  ============================================================================
  FREOS · LP Inchiesta
  ----------------------------------------------------------------------------
  Porte depuis la source autonome. La copy est verrouillee et vit inline :
  seule la cible des CTA est un reglage, sur le modele de l'advertorial Rosalia.

  Les images sont des assets du theme (freos-lp1-NN.webp) : pour en changer
  une, on remplace le fichier, pas le code.

  Le CSS ci-dessous est celui de la source, inchange. Il porte son propre reset
  et ses propres tokens — la page ne depend donc d'aucun CSS du theme.
  ============================================================================
{%- endcomment -%}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap">

<style>
:root {
  --bg: #F2ECD9;
  --paper: #FBF6E8;
  --ink: #17201A;
  --ink-2: #2E3A2E;
  --ink-3: #6A7166;
  --ink-4: #9CA095;
  --accent: #2D5A3A;
  --accent-light: #4A7C59;
  --rule: #C9C1AB;
  --rule-strong: #A69B7E;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
:root:not([data-theme="light"]) {}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #F2ECD9; --paper: #FBF6E8; --ink: #17201A; --ink-2: #2E3A2E; --ink-3: #6A7166; --ink-4: #9CA095;
    --accent: #2D5A3A; --accent-light: #4A7C59; --rule: #C9C1AB; --rule-strong: #A69B7E;
  }
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--bg); color: var(--ink); }
body { font-family: 'Source Serif 4', Georgia, serif; font-size: 18px; line-height: 1.68; -webkit-font-smoothing: antialiased; }
img, svg { max-width: 100%; display: block; }
p { margin: 0 0 1.2em; }

/* MASTHEAD */
.masthead { padding: 22px 24px 18px; text-align: center; background: var(--paper); border-bottom: 1px solid var(--rule-strong); }
.masthead-logo { font-family: 'Playfair Display', serif; font-weight: 900; font-size: clamp(24px, 4.5vw, 32px); line-height: 1; color: var(--ink); margin: 0; letter-spacing: -0.018em; }
.masthead-logo em { font-style: italic; color: var(--accent); }
.masthead-tagline { margin-top: 6px; font-family: 'Inter', sans-serif; font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink-3); font-weight: 500; }

/* ARTICLE */
.article { max-width: 720px; margin: 0 auto; padding: 44px 28px 60px; background: var(--paper); }
@media (min-width: 900px) { .article { max-width: 760px; padding: 60px 64px 90px; box-shadow: 0 0 0 1px var(--rule); } }
@media (max-width: 640px) { .article { padding: 28px 22px 44px; } }

.eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; color: var(--ink-3); margin-bottom: 22px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.eyebrow .sep { color: var(--rule-strong); }

/* H1 & SUBHEAD */
.article-h1 { font-family: 'Source Serif 4', serif; font-weight: 700; font-size: clamp(32px, 5.6vw, 50px); line-height: 1.08; color: var(--ink); margin: 0 0 24px; letter-spacing: -0.018em; }
.article-h1 em { font-style: italic; color: var(--accent); font-weight: 700; }
.subhead { font-family: 'Source Serif 4', serif; font-size: clamp(20px, 2.7vw, 24px); line-height: 1.42; font-style: italic; color: var(--ink-2); margin: 0 0 32px; font-weight: 400; }

/* BYLINE */
.byline { display: flex; align-items: center; gap: 14px; padding: 18px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); margin-bottom: 36px; }
.byline-photo { width: 48px; height: 48px; border-radius: 50%; flex-shrink: 0; overflow: hidden; }
.byline-photo img { width: 100%; height: 100%; object-fit: cover; }
.byline-author { font-family: 'Source Serif 4', serif; font-size: 14.5px; color: var(--ink); font-weight: 700; line-height: 1.3; }
.byline-author em { font-style: italic; font-weight: 400; color: var(--ink-3); }
.byline-consulenza { font-family: 'Source Serif 4', serif; font-size: 12.5px; color: var(--ink-3); font-style: italic; margin-top: 3px; line-height: 1.4; }
.byline-consulenza strong { color: var(--ink-2); font-weight: 700; font-style: normal; }

/* FIGURE */
figure { margin: 34px 0 28px; }
figure img { width: 100%; height: auto; display: block; }
figcaption { font-family: 'Source Serif 4', serif; font-size: 13px; font-style: italic; color: var(--ink-3); line-height: 1.5; margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--rule); }

/* LEAD */
.lead-para { font-family: 'Source Serif 4', serif; font-size: clamp(19px, 2.3vw, 22px); line-height: 1.55; color: var(--ink); margin: 26px 0 20px; font-weight: 400; }
.lead-para .drop { float: left; font-family: 'Playfair Display', serif; font-weight: 900; font-style: italic; font-size: clamp(64px, 9vw, 92px); line-height: 0.82; color: var(--accent); padding: 10px 12px 0 0; }
.lead-thesis { display: block; margin-top: 26px; font-style: italic; font-weight: 700; color: var(--accent); padding-left: 18px; border-left: 2px solid var(--accent); font-size: clamp(20px, 2.5vw, 24px); line-height: 1.4; }

/* SECTIONS — no more labels. Just rules + whitespace + H2. */
.section { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--rule); }
.section:first-of-type { border-top: none; margin-top: 40px; padding-top: 0; }

h2 { font-family: 'Source Serif 4', serif; font-weight: 700; font-size: clamp(26px, 4vw, 36px); line-height: 1.14; color: var(--ink); margin: 0 0 26px; letter-spacing: -0.012em; }
h2 em { font-style: italic; color: var(--accent); font-weight: 700; }
h3 { font-family: 'Source Serif 4', serif; font-weight: 700; font-style: italic; font-size: clamp(20px, 2.7vw, 24px); line-height: 1.25; color: var(--ink); margin: 34px 0 14px; }

.prose { font-family: 'Source Serif 4', serif; font-size: 18px; line-height: 1.68; color: var(--ink); }
.prose p { margin: 0 0 1.2em; }
.prose strong { font-weight: 700; color: var(--ink); }
.prose em { font-style: italic; }
.prose p.first-of-section::first-letter { font-family: 'Playfair Display', serif; font-weight: 900; font-style: italic; font-size: 4.4em; float: left; line-height: 0.82; padding: 8px 10px 0 0; color: var(--accent); }

/* TESTIMONY — no colored border. Hairline only. */
.testimony { margin: 32px 0; padding: 22px 0 18px; border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong); }
.testimony-header { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--rule); }
.testimony-photo { width: 54px; height: 54px; border-radius: 50%; flex-shrink: 0; overflow: hidden; }
.testimony-photo img { width: 100%; height: 100%; object-fit: cover; }
.testimony-name { font-family: 'Source Serif 4', serif; font-size: 15px; font-weight: 700; color: var(--ink); }
.testimony-role { font-family: 'Inter', sans-serif; font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); font-weight: 600; margin-top: 3px; }
.testimony blockquote { margin: 0; font-family: 'Source Serif 4', serif; font-size: 17px; font-style: italic; line-height: 1.55; color: var(--ink-2); }

/* PULL — thin rules only */
.pull { margin: 40px 0; padding: 24px 0; border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong); font-family: 'Source Serif 4', serif; font-style: italic; font-weight: 700; font-size: clamp(22px, 3vw, 28px); line-height: 1.32; color: var(--accent); text-align: center; }

/* SIGNALS list — no colored panel. Italic prose list under hairline. */
.signals { margin: 26px 0; padding: 18px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
.signals-title { font-family: 'Inter', sans-serif; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); font-weight: 700; margin-bottom: 12px; }
.signals ul { margin: 0; padding: 0; list-style: none; }
.signals li { font-family: 'Source Serif 4', serif; font-size: 15.5px; line-height: 1.6; color: var(--ink-2); padding: 5px 0; }
.signals li::before { content: '— '; color: var(--rule-strong); margin-right: 2px; }

/* STAGES — 4 minimal cards */
.stages { margin: 30px 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong); }
@media (max-width: 640px) { .stages { grid-template-columns: 1fr; } }
.stage { padding: 16px 14px; border-right: 1px solid var(--rule); }
.stage:last-child { border-right: none; }
@media (max-width: 640px) { .stage { border-right: none; border-bottom: 1px solid var(--rule); } .stage:last-child { border-bottom: none; } }
.stage-label { font-family: 'Inter', sans-serif; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); font-weight: 700; margin-bottom: 10px; }
.stage-text { font-family: 'Source Serif 4', serif; font-size: 14.5px; line-height: 1.5; color: var(--ink-2); }
.stage-text strong { font-weight: 700; color: var(--ink); }

/* FAILURE TABLE — hairlines only, no red */
.failure-table { margin: 28px 0; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
.failure-row { padding: 16px 0; border-bottom: 1px solid var(--rule); display: grid; grid-template-columns: 1fr; gap: 6px; }
.failure-row:last-child { border-bottom: none; }
@media (min-width: 640px) { .failure-row { grid-template-columns: 200px 1fr; gap: 22px; align-items: baseline; } }
.failure-what { font-family: 'Source Serif 4', serif; font-weight: 700; font-size: 15.5px; color: var(--ink); }
.failure-why { font-family: 'Source Serif 4', serif; font-size: 15px; line-height: 1.55; color: var(--ink-2); }
.failure-why em { color: var(--ink); font-style: italic; font-weight: 600; }

/* ANATOMIA — 4-phase minimal grid */
.phase-anatomia { margin: 34px 0; display: grid; grid-template-columns: 1fr; gap: 24px; }
@media (min-width: 700px) { .phase-anatomia { grid-template-columns: 1fr 1fr; gap: 20px; } }
.phase-card { background: transparent; }
.phase-card img { width: 100%; height: auto; display: block; border: 1px solid var(--rule); }
.phase-title { font-family: 'Source Serif 4', serif; font-weight: 700; font-style: italic; font-size: 14.5px; color: var(--accent); margin-top: 14px; margin-bottom: 6px; }
.phase-num { display: inline-block; margin-right: 6px; font-family: 'Playfair Display', serif; font-style: italic; font-weight: 900; font-size: 20px; color: var(--rule-strong); }
.phase-body p { margin: 0; font-family: 'Source Serif 4', serif; font-size: 14.5px; line-height: 1.55; color: var(--ink-2); }
.phase-body p strong { font-weight: 700; color: var(--ink); }

/* PRODUCT SECTION — no colored panels */
.product-photo { margin: 34px auto; max-width: 380px; }
.product-photo img { width: 100%; height: auto; display: block; border: 1px solid var(--rule); }
.product-photo figcaption { text-align: center; padding-top: 10px; border-top: 1px solid var(--rule); }

/* PRICE — editorial standfirst */
.price-block { margin: 40px 0 30px; padding: 30px 0; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); text-align: center; }
.price-headline { font-family: 'Playfair Display', serif; font-weight: 900; font-style: italic; font-size: clamp(30px, 5vw, 42px); line-height: 1.1; color: var(--ink); margin: 0 0 12px; letter-spacing: -0.01em; }
.price-body { font-family: 'Source Serif 4', serif; font-size: 16px; line-height: 1.55; color: var(--ink-2); max-width: 480px; margin: 0 auto 20px; }
.price-body em { font-style: italic; color: var(--accent); font-weight: 600; }
.price-cta { display: inline-block; padding: 4px 0; font-family: 'Source Serif 4', serif; font-size: 22px; font-weight: 700; font-style: italic; color: var(--accent); text-decoration: none; border-bottom: 2px solid var(--accent); transition: color .15s; }
.price-cta:hover { color: var(--ink); border-bottom-color: var(--ink); }
.price-guarantee { margin-top: 14px; font-family: 'Source Serif 4', serif; font-size: 13px; font-style: italic; color: var(--ink-3); }

/* PAIRS */
.pairs { margin: 24px 0; }
.pair { display: grid; grid-template-columns: 1fr; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--rule); }
.pair:last-child { border-bottom: none; }
@media (min-width: 640px) { .pair { grid-template-columns: 1fr 24px 1fr; align-items: center; gap: 18px; } }
.pair-arrow { font-family: 'Playfair Display', serif; font-size: 20px; color: var(--rule-strong); text-align: center; }
.pair-now { font-family: 'Source Serif 4', serif; font-size: 15px; color: var(--ink-3); font-style: italic; line-height: 1.45; }
.pair-desire { font-family: 'Source Serif 4', serif; font-size: 15px; color: var(--ink); font-weight: 700; line-height: 1.45; }

/* FAQ */
.faq { margin: 26px 0; border-top: 1px solid var(--rule-strong); }
.faq-item { padding: 18px 0; border-bottom: 1px solid var(--rule); }
.faq-q { font-family: 'Source Serif 4', serif; font-weight: 700; font-size: 16.5px; color: var(--ink); margin-bottom: 8px; line-height: 1.4; }
.faq-a { font-family: 'Source Serif 4', serif; font-size: 15px; line-height: 1.55; color: var(--ink-2); }

/* FONTI */
.fonti { margin: 40px 0 0; padding: 22px 0; border-top: 1px solid var(--rule-strong); }
.fonti-title { font-family: 'Inter', sans-serif; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); font-weight: 700; margin-bottom: 10px; }
.fonti ol { margin: 0; padding-left: 20px; font-family: 'Source Serif 4', serif; font-size: 12px; line-height: 1.6; color: var(--ink-3); }
.fonti li { margin-bottom: 4px; }
.fonti em { font-style: italic; }

/* COLOPHON */
.colophon { background: var(--ink); color: var(--paper); padding: 48px 24px 32px; margin-top: 0; }
.colophon-inner { max-width: 780px; margin: 0 auto; }
.colophon-masthead { text-align: center; padding-bottom: 28px; border-bottom: 1px solid rgba(251,246,232,0.15); margin-bottom: 30px; }
.colophon-logo { font-family: 'Playfair Display', serif; font-weight: 900; font-size: 26px; color: var(--paper); line-height: 1; letter-spacing: -0.015em; }
.colophon-logo em { font-style: italic; color: var(--accent-light); }
.colophon-tagline { margin-top: 8px; font-family: 'Inter', sans-serif; font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(251,246,232,0.55); font-weight: 500; }
.colophon-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 32px; margin-bottom: 32px; }
@media (max-width: 640px) { .colophon-grid { grid-template-columns: 1fr; gap: 20px; } }
.colophon-label { font-family: 'Inter', sans-serif; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-light); font-weight: 700; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px solid rgba(127,164,138,0.3); }
.colophon-body { font-family: 'Source Serif 4', serif; font-size: 13px; line-height: 1.55; color: rgba(251,246,232,0.85); }
.colophon-body strong { color: var(--paper); font-weight: 700; }
.colophon-legal { padding-top: 24px; border-top: 1px solid rgba(251,246,232,0.15); font-family: 'Source Serif 4', serif; font-size: 11.5px; line-height: 1.55; color: rgba(251,246,232,0.6); }
.colophon-legal p { margin: 0 0 12px; }
.colophon-legal p strong { color: rgba(251,246,232,0.85); font-weight: 700; }
.colophon-copy { margin-top: 18px !important; padding-top: 14px; border-top: 1px solid rgba(251,246,232,0.1); font-size: 10.5px; letter-spacing: 0.02em; color: rgba(251,246,232,0.45); }
.colophon-copy a { color: rgba(251,246,232,0.6); text-decoration: none; margin: 0 4px; }
.colophon-copy a:hover { color: var(--accent-light); }

