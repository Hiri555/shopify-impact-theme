{%- comment -%}
  ============================================================================
  FREOS · PDP 13 — FREOS · 13 Garanzia
  ----------------------------------------------------------------------------
  Bloc de renversement du risque. Le lien laisse vide ramene au bouton
  d'achat de la buybox par defilement, comme le fait la reference -- plutot
  que de recharger la page sur elle-meme.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur
  dans ce fichier. Genere par build_pdp_sections.py -- modifier le generateur,
  pas ce fichier, sinon la prochaine generation ecrase la retouche.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--garanzia fr-pdp--center fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    {%- if section.settings.shield -%}
      <svg class="fr-shield" viewBox="0 0 22 22" fill="none" stroke="currentColor"
           stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M11 2.5 3.8 5.2v6.1c0 4.2 3 7.5 7.2 8.5 4.2-1 7.2-4.3 7.2-8.5V5.2Z"/>
        <path d="M7.6 11.2 10 13.6l4.6-5"/>
      </svg>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="fr-rt fr-guar-rt">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <p class="fr-guar-cta">
        <a class="fr-cta" href="{{ section.settings.cta_url | default: '#fr-buybox' }}"
           data-scroll="{% if section.settings.cta_url == blank %}1{% endif %}">
          {{- section.settings.cta_label -}}
          {%- if section.settings.cta_pill != blank -%}
            <span class="fr-cta-pill">{{ section.settings.cta_pill }}</span>
          {%- endif -%}
        </a>
      </p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fr-badges">
        {%- for block in section.blocks -%}
          <div class="fr-badge" {{ block.shopify_attributes }}>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.3 6.4 12 13 4.5"/></svg>
            <b class="fr-badge-n">{{ block.settings.title }}</b>
            {%- if block.settings.sub != blank -%}
              <span class="fr-badge-s">{{ block.settings.sub }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.legal != blank -%}
      <p class="fr-guar-legal">{{ section.settings.legal }}</p>
    {%- endif -%}

  </div>
</div>
<script>
(function(){
  var sec = document.getElementById('shopify-section-{{ section.id }}');
  var a = sec && sec.querySelector('.fr-cta[data-scroll="1"]'); if(!a) return;
  a.addEventListener('click', function(e){
    var t = document.querySelector('.fr-atc-wrap'); if(!t) return;   /* pas de cible : lien normal */
    e.preventDefault();
    t.scrollIntoView({behavior:'smooth', block:'center'});
  });
})();
</script>
{% schema %}
{
  "name": "FREOS · 13 Garanzia",
  "tag": "section",
  "class": "freos-pdp-garanzia",
  "settings": [
    {
      "type": "header",
      "content": "Corps"
    },
    {
      "type": "checkbox",
      "id": "shield",
      "label": "Afficher le bouclier",
      "default": true
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texte"
    },
    {
      "type": "header",
      "content": "Bouton"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Libelle"
    },
    {
      "type": "text",
      "id": "cta_pill",
      "label": "Pastille de prix"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Lien",
      "info": "Vide = ramene au bouton d'achat en haut de page."
    },
    {
      "type": "textarea",
      "id": "legal",
      "label": "Mention legale"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Reassurance",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Precision"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS · 13 Garanzia"
    }
  ]
}
{% endschema %}
