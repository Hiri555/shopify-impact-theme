{%- comment -%}
  ============================================================================
  FREOS · LP — FREOS LP · Sponsor
  ----------------------------------------------------------------------------
  Le bandeau « Contenuto sponsorizzato ». Obligatoire en tete des trois pages :
  la mention doit se lire avant le premier caractere de l'article.
  Le reglage `scope` choisit la feuille (fr-lp1 / fr-lp2 / fr-lp3 / fr-lp4).
  Genere par build_lp_sections_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}{% unless section.settings.rule %} no-rule{% endunless %}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
{%- if section.settings.kicker != blank -%}<p class="k">{{ section.settings.kicker }}</p>{%- endif -%}  {%- if section.settings.text != blank or section.settings.link != blank -%}
    <div class="freos-spon">{{ section.settings.text }}
      {%- if section.settings.link != blank -%}
        <a class="spon-a" href="{{ section.settings.url | default: '/' }}">{{ section.settings.link }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "FREOS LP · Sponsor",
  "tag": "section",
  "class": "freos-lp-spon",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "info": "La petite ligne au-dessus du titre. Vide = rien."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Mention",
      "default": "Contenuto sponsorizzato · FREOS"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Lien de la barre",
      "info": "Le cadre CROEvolution veut l'offre en une ligne, tout en haut. Vide = pas de lien."
    },
    {
      "type": "text",
      "id": "url",
      "label": "Destination du lien"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Page",
      "default": "fr-lp1",
      "info": "Choisit la feuille de style appliquee. Une section deplacee d'une LP a l'autre doit changer de page ici.",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        },
        {
          "value": "fr-lp4",
          "label": "Prelander · A Bocca Chiusa"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "checkbox",
      "id": "rule",
      "label": "Filet de separation au-dessus",
      "info": "A decocher sur la premiere partie de l'article.",
      "default": true
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "FREOS LP · Sponsor"
    }
  ]
}
{% endschema %}
