{%- comment -%}
  ============================================================================
  FREOS · PDP — FREOS · 05 Benefici
  ----------------------------------------------------------------------------
  Quatre lignes, pas plus. Chacune : une icone, la phrase, une etiquette a
  droite. L'etiquette dit le REGISTRE de la promesse (le moment, l'effort,
  la texture, la duree) -- elle ne repete pas la phrase.
  Chaque promesse porte sur la FORME, le MOMENT ou le GESTE. Aucune ne
  porte sur un effet : c'est un complement alimentaire.
  L'icone est du SVG colle dans un reglage, donc editable sans toucher au
  code -- quatre icones par defaut sont fournies dans les presets.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur.
  Genere par build_pdp_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--benefici fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <ul class="fr-bens">
      {%- for block in section.blocks -%}
        <li class="fr-ben" {{ block.shopify_attributes }}>
          <span class="fr-ben-i" aria-hidden="true">{{ block.settings.icona }}</span>
          <span class="fr-ben-t">{{ block.settings.text }}</span>
          {%- if block.settings.tag != blank -%}
            <span class="fr-ben-g">{{ block.settings.tag }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.foot != blank -%}
      <p class="fr-bens-foot">{{ section.settings.foot }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS · 05 Benefici",
  "tag": "section",
  "class": "freos-pdp-benefici",
  "settings": [
    {
      "type": "header",
      "content": "Bas de section"
    },
    {
      "type": "text",
      "id": "foot",
      "label": "Ligne de pied"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "wide",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "ben",
      "name": "Beneficio",
      "settings": [
        {
          "type": "textarea",
          "id": "icona",
          "label": "Icone (SVG)",
          "info": "Colle un <svg>. Vide = pas d'icone."
        },
        {
          "type": "text",
          "id": "text",
          "label": "La phrase"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Etiquette"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
