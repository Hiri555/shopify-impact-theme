{%- comment -%}
  ============================================================================
  FREOS · LP — FREOS LP · Rimedi
  ----------------------------------------------------------------------------
  Le tableau « ce que tu as essaye / pourquoi ca ne suffisait pas ». Une ligne
  par bloc.
  Le reglage `scope` choisit la feuille (fr-lp1 / fr-lp2 / fr-lp3).
  Genere par build_lp_sections_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}{% unless section.settings.rule %} no-rule{% endunless %}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
{%- if section.settings.kicker != blank -%}<p class="k">{{ section.settings.kicker }}</p>{%- endif -%}
  <section class="section">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="prose">{{ section.settings.intro }}</div>{%- endif -%}
    <div class="failure-table">
      {%- for block in section.blocks -%}
        <div class="failure-row{% if block.settings.hot %} hot{% endif %}" {{ block.shopify_attributes }}>
          <div class="failure-what">{{ block.settings.what }}</div>
          <div class="failure-why">{{ block.settings.why }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.outro != blank -%}<div class="prose">{{ section.settings.outro }}</div>{%- endif -%}
    {%- if section.settings.outro_pull != blank -%}
      <div class="pull">{{ section.settings.outro_pull }}</div>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "FREOS LP · Rimedi",
  "tag": "section",
  "class": "freos-lp-failures",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "info": "La petite ligne au-dessus du titre. Vide = rien."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre de section"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "richtext",
      "id": "outro",
      "label": "Conclusion"
    },
    {
      "type": "text",
      "id": "outro_pull",
      "label": "La phrase detachee, en fin de tableau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Page",
      "default": "fr-lp1",
      "info": "Choisit la feuille de style appliquee. Une section deplacee d'une LP a l'autre doit changer de page ici.",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "checkbox",
      "id": "rule",
      "label": "Filet de separation au-dessus",
      "info": "A decocher sur la premiere partie de l'article.",
      "default": true
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Rimedio",
      "settings": [
        {
          "type": "text",
          "id": "what",
          "label": "Le geste"
        },
        {
          "type": "textarea",
          "id": "why",
          "label": "Pourquoi il ne suffit pas"
        },
        {
          "type": "checkbox",
          "id": "hot",
          "label": "Ligne mise en avant",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS LP · Rimedi"
    }
  ]
}
{% endschema %}
