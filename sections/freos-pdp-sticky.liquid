{%- comment -%}
  ============================================================================
  FREOS · PDP 15 — BARRE D'ACHAT COLLANTE
  ----------------------------------------------------------------------------
  Cette section n'emet AUCUN formulaire. Elle pointe celui de la section 02
  par l'attribut HTML form="", exactement comme product-quick-add le fait
  chez Impact : un seul <form is="product-form"> sur la page, plusieurs
  <buy-buttons> qui le visent.

  L'identifiant est donc recopie a l'identique depuis freos-pdp-buybox.liquid.
  S'il divergeait, document.forms[...] ne resoudrait pas et l'element
  cesserait de reagir EN SILENCE -- le bouton posterait quand meme, mais sans
  AJAX ni cart drawer. C'est verifie sur le rendu, pas suppose.

  Pas de prix dans la barre : c'est ce que fait la reference, et ca evite un
  second endroit ou le prix pourrait diverger de celui de la buybox.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign p = product
  capture form_id
    echo 'freos-pdp-form-'
    echo p.id
    echo '-'
    echo p.selected_or_first_available_variant.id
  endcapture

  assign thumb = section.settings.image
  assign thumb_file = section.settings.file | strip

  comment
    Meme precaution que dans le snippet : on ne chaine pas default puis t.
  endcomment
  assign cta = section.settings.cta
  if cta == blank
    assign cta = 'product.general.add_to_cart_button' | t
  endif
  assign cta_off = section.settings.soldout
  if cta_off == blank
    assign cta_off = 'product.general.sold_out_button' | t
  endif
-%}

<div class="fr fr-sticky" id="fr-sticky-{{ section.id }}"
     data-watch="{{ section.settings.watch | default: '.fr-atc-wrap' }}">
  <div class="wide fr-sticky-in">

    {%- if thumb != blank or thumb_file != blank -%}
      <span class="fr-sticky-img" aria-hidden="true">
        {%- if thumb != blank -%}
          {{ thumb | image_url: width: 160 | image_tag: widths: '60,120,160', sizes: '60px', alt: '', loading: 'lazy' }}
        {%- else -%}
          <img src="{{ thumb_file | asset_url }}" alt="" width="60" height="60" loading="lazy">
        {%- endif -%}
      </span>
    {%- endif -%}

    <span class="fr-sticky-txt">
      {%- if section.settings.show_rating -%}
        <span class="fr-sticky-rate">
          <span class="fr-rate-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6z"/></svg>
            {%- endfor -%}
          </span>
          <span class="fr-sticky-score">{{ section.settings.score }}</span>
        </span>
      {%- endif -%}
      <span class="fr-sticky-t">{{ section.settings.label | default: p.title }}</span>
    </span>

    <buy-buttons class="buy-buttons fr-atc-bb fr-sticky-bb"
                 template="{{ p.template_suffix | escape }}"
                 form="{{ form_id }}"
                 force-secondary-button>
      <button type="submit"
              is="custom-button"
              class="button fr-atc fr-sticky-b{% unless p.available %} fr-atc--off{% endunless %}"
              form="{{ form_id }}"
              {% unless p.available %}disabled{% endunless %}>
        {%- if p.available -%}{{ cta }}{%- else -%}{{ cta_off }}{%- endif -%}
      </button>
    </buy-buttons>

  </div>
</div>

<style>
  {%- if section.settings.atc_bg != blank and section.settings.atc_bg != 'rgba(0,0,0,0)' -%}
    #shopify-section-{{ section.id }} .fr-atc{ --button-background: {{ section.settings.atc_bg.rgb }}; }
  {%- endif -%}
  {%- if section.settings.atc_fg != blank and section.settings.atc_fg != 'rgba(0,0,0,0)' -%}
    #shopify-section-{{ section.id }} .fr-atc{ --button-text-color: {{ section.settings.atc_fg.rgb }}; }
  {%- endif -%}
</style>

<script>
(function(){
  var bar = document.getElementById('fr-sticky-{{ section.id }}');
  if(!bar) return;

  /* On n'intercepte RIEN : le bouton est un vrai submit rattache au formulaire
     de la buybox par form="". Ce script ne fait qu'afficher et masquer.

     Un ecouteur de defilement plutot qu'un IntersectionObserver : la regle
     tient en deux comparaisons de geometrie, elle se relit, et elle
     s'appelle a la main -- ce qui la rend verifiable. La fonction est exposee
     sur l'element pour pouvoir etre declenchee sans evenement. */
  var watch = document.querySelector(bar.dataset.watch || '.fr-atc-wrap');
  if(!watch){ bar.classList.add('is-on'); return; }   /* pas de cible : on montre */

  var footer = document.querySelector('.fr-footer, .footer');

  bar.frSync = function(){
    var passe = watch.getBoundingClientRect().bottom < 0;
    var finPage = footer ? footer.getBoundingClientRect().top < window.innerHeight : false;
    bar.classList.toggle('is-on', passe && !finPage);
    return {passe: passe, finPage: finPage, visible: bar.classList.contains('is-on')};
  };

  addEventListener('scroll', bar.frSync, {passive: true});
  addEventListener('resize', bar.frSync, {passive: true});
  bar.frSync();
})();
</script>

{% schema %}
{
  "name": "FREOS · 15 Sticky",
  "tag": "section",
  "class": "freos-pdp-sticky",
  "settings": [
    { "type": "paragraph", "content": "Le bouton vise le formulaire de la section Buybox. Ne pas retirer la Buybox de la page." },
    { "type": "header", "content": "Contenu" },
    { "type": "image_picker", "id": "image", "label": "Vignette" },
    { "type": "text", "id": "file", "label": "Ou : asset du theme", "info": "Nom de fichier, utilise si aucune image n'est deposee." },
    { "type": "text", "id": "label", "label": "Libelle", "info": "Vide = titre du produit." },
    { "type": "checkbox", "id": "show_rating", "label": "Afficher la note", "default": true },
    { "type": "text", "id": "score", "label": "Note" },
    { "type": "header", "content": "Bouton" },
    { "type": "text", "id": "cta", "label": "Libelle", "default": "Aggiungi al carrello",
      "info": "La locale publiee du store est l'anglais : si ce champ est vide, le bouton sort en anglais." },
    { "type": "text", "id": "soldout", "label": "Rupture", "default": "Non disponibile",
      "info": "Meme remarque : ne pas laisser vide." },
    { "type": "color", "id": "atc_bg", "label": "Fond du bouton" },
    { "type": "color", "id": "atc_fg", "label": "Texte du bouton" },
    { "type": "header", "content": "Declenchement" },
    { "type": "text", "id": "watch", "label": "Element surveille", "default": ".fr-atc-wrap",
      "info": "La barre apparait quand cet element sort par le haut. Par defaut : le bouton d'achat de la buybox." }
  ],
  "presets": [{ "name": "FREOS · 15 Sticky" }]
}
{% endschema %}
