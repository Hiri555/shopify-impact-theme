{%- comment -%}
  ============================================================================
  FREOS · LP — FREOS LP · Offerta
  ----------------------------------------------------------------------------
  Le bloc prix. La ligne de garantie n'est pas optionnelle par accident : si
  elle manque, la page annonce un prix sans dire ce qui se passe si ca ne
  convient pas.
  Le reglage `scope` choisit la feuille (fr-lp1 / fr-lp2 / fr-lp3).
  Genere par build_lp_sections_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}{% unless section.settings.rule %} no-rule{% endunless %}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
{%- if section.settings.kicker != blank -%}<p class="k">{{ section.settings.kicker }}</p>{%- endif -%}
  {%- if section.settings.heading != blank or section.settings.intro != blank -%}
    <section class="section">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="prose">{{ section.settings.intro }}</div>
      {%- endif -%}
    </section>
  {%- endif -%}
  <div class="price-block">
    {%- if section.settings.photo != blank or section.settings.photo_file != blank -%}
      <div class="price-photo">
        {%- if section.settings.photo != blank -%}
          {{ section.settings.photo | image_url: width: 600 | image_tag: widths: '220,440,600', sizes: '220px', alt: section.settings.photo_alt }}
        {%- else -%}
          <img src="{{ section.settings.photo_file | strip | asset_url }}" alt="{{ section.settings.photo_alt | escape }}" loading="lazy">
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.headline != blank -%}<div class="price-headline">{{ section.settings.headline }}</div>{%- endif -%}
    {%- if section.settings.body != blank -%}<div class="price-body">{{ section.settings.body }}</div>{%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/' }}" class="price-cta">{{ section.settings.cta_label }}</a>
    {%- endif -%}
    {%- if section.settings.guarantee != blank -%}<div class="price-guarantee">{{ section.settings.guarantee }}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS LP · Offerta",
  "tag": "section",
  "class": "freos-lp-offer",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "info": "La petite ligne au-dessus du titre. Vide = rien."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre de section",
      "info": "Optionnel. Le texte de conclusion qui precede le prix."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Avant le bloc prix"
    },
    {
      "type": "header",
      "content": "Le bloc prix"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Photo du produit"
    },
    {
      "type": "text",
      "id": "photo_file",
      "label": "Ou : asset du theme"
    },
    {
      "type": "text",
      "id": "photo_alt",
      "label": "Texte alternatif"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Accroche"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Libelle du bouton"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Lien"
    },
    {
      "type": "richtext",
      "id": "guarantee",
      "label": "Garantie"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Page",
      "default": "fr-lp1",
      "info": "Choisit la feuille de style appliquee. Une section deplacee d'une LP a l'autre doit changer de page ici.",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "checkbox",
      "id": "rule",
      "label": "Filet de separation au-dessus",
      "info": "A decocher sur la premiere partie de l'article.",
      "default": true
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "FREOS LP · Offerta"
    }
  ]
}
{% endschema %}
