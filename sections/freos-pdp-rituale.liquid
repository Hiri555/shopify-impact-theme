{%- comment -%}
  ============================================================================
  FREOS · PDP — FREOS · 09 Rituale
  ----------------------------------------------------------------------------
  Trois cartes numerotees. EN PLACEHOLDER ASSUME : le proprietaire remplit
  apres. Aucune posologie n'est inventee ici -- un mode d'emploi faux sur une
  fiche de complement est pire qu'un mode d'emploi absent.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur.
  Genere par build_pdp_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--rituale fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-steps">
      {%- for block in section.blocks -%}
        <article class="fr-step" {{ block.shopify_attributes }}>
          <span class="fr-step-ph">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                   widths: '320,520,800', sizes: '(max-width:860px) 42vw, 300px',
                   alt: block.settings.label, class: 'fr-step-img', loading: 'lazy' }}
            {%- elsif block.settings.file != blank -%}
              <img class="fr-step-img" src="{{ block.settings.file | strip | asset_url }}"
                   alt="{{ block.settings.label | escape }}" loading="lazy">
            {%- endif -%}
          </span>
          <p class="fr-step-n" aria-hidden="true">{{ block.settings.num }}</p>
          <p class="fr-step-l">{{ block.settings.label }}</p>
          {%- if block.settings.text != blank -%}
            <p class="fr-step-x">{{ block.settings.text }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.foot != blank -%}
      <p class="fr-steps-foot">{{ section.settings.foot }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS · 09 Rituale",
  "tag": "section",
  "class": "freos-pdp-rituale",
  "settings": [
    {
      "type": "header",
      "content": "Bas de section"
    },
    {
      "type": "text",
      "id": "foot",
      "label": "Ligne de pied"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "wide",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Passaggio",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "file",
          "label": "Ou : asset du theme"
        },
        {
          "type": "text",
          "id": "num",
          "label": "Numero",
          "default": "01"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Libelle"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Micro-texte"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
