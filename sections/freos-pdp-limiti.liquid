{%- comment -%}
  ============================================================================
  FREOS · PDP 12 — FREOS · 12 Limiti
  ----------------------------------------------------------------------------
  Ce que le produit ne fait pas. Section d'honnetete : elle porte aussi le
  renvoi medical, qui doit rester visible et n'est pas negociable.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur
  dans ce fichier. Genere par build_pdp_sections.py -- modifier le generateur,
  pas ce fichier, sinon la prochaine generation ecrase la retouche.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--limiti fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <ul class="fr-nolist">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.note != blank -%}
      <div class="fr-note">{{ section.settings.note }}</div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "FREOS · 12 Limiti",
  "tag": "section",
  "class": "freos-pdp-limiti",
  "settings": [
    {
      "type": "header",
      "content": "Renvoi"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note de prudence"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Limite",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS · 12 Limiti"
    }
  ]
}
{% endschema %}
