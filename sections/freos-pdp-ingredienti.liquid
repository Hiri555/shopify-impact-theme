{%- comment -%}
  ============================================================================
  FREOS · PDP — FREOS · 06 Ingredienti
  ----------------------------------------------------------------------------
  Un rail qui defile a l'horizontale : a 390 px une carte fait 78 pour cent
  de la largeur, donc la suivante depasse toujours un peu. C'est ce
  depassement qui dit « ca continue » -- une grille coupee net ne le dit pas.
  La dose est un champ a part, en gros et en vert : c'est ce qui separe une
  fiche credible d'une liste de mots.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur.
  Genere par build_pdp_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--ingredienti fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-rail" role="list">
      {%- for block in section.blocks -%}
        <article class="fr-icard" role="listitem" {{ block.shopify_attributes }}>
          <span class="fr-icard-ph">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                   widths: '320,520,800', sizes: '(max-width:860px) 78vw, 260px',
                   alt: block.settings.name, class: 'fr-icard-img', loading: 'lazy' }}
            {%- elsif block.settings.file != blank -%}
              <img class="fr-icard-img" src="{{ block.settings.file | strip | asset_url }}"
                   alt="{{ block.settings.name | escape }}" loading="lazy">
            {%- endif -%}
            {%- if block.settings.icon != blank and block.settings.icon != 'nessuna' -%}
              <span class="fr-icard-ic" aria-hidden="true">{% render 'freos-icone', nom: block.settings.icon %}</span>
            {%- endif -%}
          </span>
          <div class="fr-icard-b">
            <b class="fr-icard-n">{{ block.settings.name }}</b>
            {%- if block.settings.benefit != blank -%}
              <p class="fr-icard-be">{{ block.settings.benefit }}</p>
            {%- endif -%}
            {%- if block.settings.dose != blank -%}
              <p class="fr-icard-d">{{ block.settings.dose }}</p>
            {%- endif -%}
            {%- if block.settings.quote != blank -%}
              <p class="fr-icard-q">{{ block.settings.quote }}</p>
            {%- endif -%}
            {%- if block.settings.role != blank -%}
              <p class="fr-icard-r">{{ block.settings.role }}</p>
            {%- endif -%}
            {%- if block.settings.pill != blank -%}
              <p class="fr-icard-p">{{ block.settings.pill }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    <p class="fr-rail-hint" aria-hidden="true">Scorri &#8594;</p>

    {%- if section.settings.note != blank -%}
      <div class="fr-ings-note">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FREOS · 06 Ingredienti",
  "tag": "section",
  "class": "freos-pdp-ingredienti",
  "settings": [
    {
      "type": "header",
      "content": "Bas de section"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Composition et avertissements"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "wide",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "ing",
      "name": "Ingrediente",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "file",
          "label": "Ou : asset du theme"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom"
        },
        {
          "type": "text",
          "id": "benefit",
          "label": "Benefice ressenti",
          "info": "Ce que ca change pour la personne. Exemple : le freno che tiene mentre dormi."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icone du benefice",
          "default": "foglia",
          "info": "Elle illustre le BENEFICE, pas la plante.",
          "options": [
            {
              "value": "nessuna",
              "label": "Aucune"
            },
            {
              "value": "freno",
              "label": "Frein — ce qui retient"
            },
            {
              "value": "notte",
              "label": "Nuit — pendant le sommeil"
            },
            {
              "value": "fresco",
              "label": "Fraicheur — ce qu'on sent"
            },
            {
              "value": "base",
              "label": "Base — le socle"
            },
            {
              "value": "foglia",
              "label": "Feuille — vegetal"
            },
            {
              "value": "dolce",
              "label": "Douceur — la cloture"
            },
            {
              "value": "tempo",
              "label": "Duree — ce qui reste"
            },
            {
              "value": "radice",
              "label": "Racine — la tradition"
            }
          ]
        },
        {
          "type": "text",
          "id": "dose",
          "label": "Dose",
          "info": "En gros et en vert. Exemple : 1,38 mg (14 pour cent VNR)."
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Citation",
          "info": "Une ligne, en italique. Le role en six mots."
        },
        {
          "type": "textarea",
          "id": "role",
          "label": "Paragraphe"
        },
        {
          "type": "text",
          "id": "pill",
          "label": "Pastille",
          "info": "Exemple : 01 · LA SERA"
        }
      ]
    }
  ]
}
{% endschema %}
