{%- comment -%}
  ============================================================================
  FREOS · PDP 06 — FREOS · 06 Ingredienti
  ----------------------------------------------------------------------------
  Une carte par ingredient : photo, nom, role, dose. La dose est un champ a
  part pour qu'elle soit lisible d'un coup d'oeil -- c'est ce qui separe une
  fiche credible d'une liste de mots.
  Tout le contenu visible est un reglage ou un bloc : rien n'est ecrit en dur
  dans ce fichier. Genere par build_pdp_sections.py -- modifier le generateur,
  pas ce fichier, sinon la prochaine generation ecrase la retouche.
  ============================================================================
{%- endcomment -%}

<div class="fr fr-pdp fr-pdp--ingredienti fr-surface--{{ section.settings.surface }}"
     style="--fr-pt:{{ section.settings.padding_top }}px;--fr-pb:{{ section.settings.padding_bottom }}px">
  <div class="{{ section.settings.width }}">

  {%- if section.settings.kicker != blank or section.settings.heading != blank
        or section.settings.dek != blank -%}
    <header class="fr-sh">
      {%- if section.settings.kicker != blank -%}
        <p class="chip">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.dek != blank -%}
        <p class="fr-dek">{{ section.settings.dek }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

    <div class="fr-ings">
      {%- for block in section.blocks -%}
        <figure class="fr-ing" {{ block.shopify_attributes }}>
          <span class="fr-ing-ph">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag:
                   widths: '200,300,400', sizes: '(max-width:640px) 40vw, 180px', alt: '', loading: 'lazy' }}
            {%- elsif block.settings.file != blank -%}
              <img src="{{ block.settings.file | strip | asset_url }}" alt=""
                   width="400" height="400" loading="lazy">
            {%- endif -%}
          </span>
          <figcaption>
            <b class="fr-ing-n">{{ block.settings.name }}</b>
            {%- if block.settings.dose != blank -%}
              <span class="fr-ing-d">{{ block.settings.dose }}</span>
            {%- endif -%}
            {%- if block.settings.role != blank -%}
              <span class="fr-ing-r">{{ block.settings.role }}</span>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <div class="fr-ings-note">{{ section.settings.note }}</div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "FREOS · 06 Ingredienti",
  "tag": "section",
  "class": "freos-pdp-ingredienti",
  "settings": [
    {
      "type": "header",
      "content": "Bas de section"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Composition et avertissements"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "<em>...</em> met un fragment en italique d'accent."
    },
    {
      "type": "textarea",
      "id": "dek",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Sable"
        },
        {
          "value": "softer",
          "label": "Sable clair"
        },
        {
          "value": "ink",
          "label": "Encre"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Colonne de lecture"
        },
        {
          "value": "wide",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "ing",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "file",
          "label": "Ou : asset du theme",
          "info": "Nom de fichier, utilise si aucune photo n'est deposee."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom"
        },
        {
          "type": "text",
          "id": "dose",
          "label": "Dose"
        },
        {
          "type": "textarea",
          "id": "role",
          "label": "Role"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS · 06 Ingredienti"
    }
  ]
}
{% endschema %}
