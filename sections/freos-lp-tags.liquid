{%- comment -%}
  ============================================================================
  FREOS · PRELANDER — Prelander · Mots-cles
  ----------------------------------------------------------------------------
  Les pastilles de fin d'article. Purement editoriales.
  Tout le contenu visible est un reglage ou un bloc : rien n'est en dur.
  Genere par build_prelander.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  <div class="pl-w">
    <div class="pl-tags">
      {%- for block in section.blocks -%}
        <span {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Prelander · Mots-cles",
  "tag": "section",
  "class": "freos-lp-tags",
  "settings": [
    {
      "type": "select",
      "id": "scope",
      "label": "Feuille de style",
      "default": "fr-lp4",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        },
        {
          "value": "fr-lp4",
          "label": "Prelander · A Bocca Chiusa"
        }
      ]
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Mot-cle",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libelle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prelander · Mots-cles"
    }
  ]
}
{% endschema %}
