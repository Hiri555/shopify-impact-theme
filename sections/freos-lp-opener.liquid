{%- comment -%}
  ============================================================================
  FREOS · LP — FREOS LP · Apertura
  ----------------------------------------------------------------------------
  L'ouverture de l'article : sur-titre, titre, chapeau, signature, image
  d'ouverture, puis les paragraphes d'attaque.

  Les paragraphes sont des blocs : on en ajoute, on en retire, on les
  reordonne. Le premier recoit automatiquement la lettrine.
  Le reglage `scope` choisit la feuille (fr-lp1 / fr-lp2 / fr-lp3).
  Genere par build_lp_sections_v2.py -- modifier le generateur, pas ce fichier.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}{% unless section.settings.rule %} no-rule{% endunless %}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
{%- if section.settings.kicker != blank -%}<p class="k">{{ section.settings.kicker }}</p>{%- endif -%}  <article class="article">
    {%- if section.settings.eyebrow != blank -%}
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="article-h1">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subhead != blank -%}
      <p class="subhead">{{ section.settings.subhead }}</p>
    {%- endif -%}

    {%- if section.settings.author != blank or section.settings.portrait != blank -%}
      <div class="byline">
        {%- if section.settings.portrait != blank or section.settings.portrait_file != blank -%}
          <div class="byline-photo">
            {%- if section.settings.portrait != blank -%}
              {{ section.settings.portrait | image_url: width: 200 | image_tag: widths: '100,200', sizes: '56px', alt: section.settings.author }}
            {%- else -%}
              <img src="{{ section.settings.portrait_file | strip | asset_url }}" alt="{{ section.settings.author | escape }}" loading="lazy">
            {%- endif -%}
          </div>
        {%- endif -%}
        <div>
          {%- if section.settings.author != blank -%}
            <div class="byline-author">{{ section.settings.author }}</div>
          {%- endif -%}
          {%- if section.settings.consulenza != blank -%}
            <div class="byline-consulenza">{{ section.settings.consulenza }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.hero != blank or section.settings.hero_file != blank -%}
      <figure>
        {%- if section.settings.hero != blank -%}
          {{ section.settings.hero | image_url: width: 1200 | image_tag: widths: '480,760,1000,1200', sizes: '(max-width:760px) 100vw, 720px', alt: section.settings.hero_alt }}
        {%- else -%}
          <img src="{{ section.settings.hero_file | strip | asset_url }}" alt="{{ section.settings.hero_alt | escape }}" loading="eager">
        {%- endif -%}
        {%- if section.settings.hero_caption != blank -%}
          <figcaption>{{ section.settings.hero_caption }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

    <div class="prose">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'lead' -%}
            <p class="lead-para" {{ block.shopify_attributes }}>
              {%- if forloop.first and block.settings.drop != blank -%}
                <span class="drop">{{ block.settings.drop }}</span>
              {%- endif -%}
              {{- block.settings.text -}}
            </p>
          {%- when 'thesis' -%}
            <p class="lead-para" {{ block.shopify_attributes }}><span class="lead-thesis">{{ block.settings.text }}</span></p>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </article>
</div>

{% schema %}
{
  "name": "FREOS LP · Apertura",
  "tag": "section",
  "class": "freos-lp-opener",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "info": "La petite ligne au-dessus du titre. Vide = rien."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "info": "Utiliser <span> pour separer les mentions."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Chapeau"
    },
    {
      "type": "header",
      "content": "Signature"
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Portrait"
    },
    {
      "type": "text",
      "id": "portrait_file",
      "label": "Ou : asset du theme"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Auteur"
    },
    {
      "type": "text",
      "id": "consulenza",
      "label": "Mention de consultation"
    },
    {
      "type": "header",
      "content": "Image d'ouverture"
    },
    {
      "type": "image_picker",
      "id": "hero",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "hero_file",
      "label": "Ou : asset du theme"
    },
    {
      "type": "text",
      "id": "hero_alt",
      "label": "Texte alternatif"
    },
    {
      "type": "textarea",
      "id": "hero_caption",
      "label": "Legende"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Page",
      "default": "fr-lp1",
      "info": "Choisit la feuille de style appliquee. Une section deplacee d'une LP a l'autre doit changer de page ici.",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "checkbox",
      "id": "rule",
      "label": "Filet de separation au-dessus",
      "info": "A decocher sur la premiere partie de l'article.",
      "default": true
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "lead",
      "name": "Paragraphe",
      "settings": [
        {
          "type": "text",
          "id": "drop",
          "label": "Lettrine",
          "info": "Une seule lettre, sur le premier paragraphe."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte"
        }
      ]
    },
    {
      "type": "thesis",
      "name": "Phrase de these",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FREOS LP · Apertura"
    }
  ]
}
{% endschema %}
