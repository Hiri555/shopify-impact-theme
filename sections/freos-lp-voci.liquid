{%- comment -%}
  ============================================================================
  FREOS · LP — VOCI
  ----------------------------------------------------------------------------
  Un rail de voix courtes, a la place d'un long recit a un seul temoin.
  Ce n'est PAS un bloc d'avis produit : aucune etoile, aucune note chiffree,
  aucune mention de source. Ce sont des voix reappropriees de notre corpus,
  reecrites en prose. Le prenom et l'age situent, ils ne prouvent rien.
  Genere par cure_vague_a.py.
  ============================================================================
{%- endcomment -%}

<div class="freos-lp-body {{ section.settings.scope }}"
     style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  {%- if section.settings.heading != blank -%}
    <h3 class="h3">{{ section.settings.heading }}</h3>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <div class="prose">{{ section.settings.intro }}</div>
  {%- endif -%}

  <p class="voci-hint" aria-hidden="true">Scorri &#8594;</p>
  <div class="voci" role="list">
    {%- for block in section.blocks -%}
      <article class="voce" role="listitem" {{ block.shopify_attributes }}>
        <p>{{ block.settings.text }}</p>
        <p class="chi">{{ block.settings.who }}</p>
      </article>
    {%- endfor -%}
  </div>

  {%- if section.settings.foot != blank -%}
    <div class="prose">{{ section.settings.foot }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "LP · Voci",
  "tag": "section",
  "class": "freos-lp-voci",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Chapeau"
    },
    {
      "type": "richtext",
      "id": "foot",
      "label": "Note de bas de section"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Feuille de style",
      "default": "fr-lp1",
      "options": [
        {
          "value": "fr-lp1",
          "label": "Adv 1 · Inchiesta"
        },
        {
          "value": "fr-lp2",
          "label": "Adv 2 · Cripta"
        },
        {
          "value": "fr-lp3",
          "label": "Listicle"
        },
        {
          "value": "fr-lp4",
          "label": "Prelander"
        }
      ]
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Marge haute",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Marge basse",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "voce",
      "name": "Voce",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Ce qu'elle dit",
          "info": "Deux ou trois phrases. En prose, sans guillemets de citation."
        },
        {
          "type": "text",
          "id": "who",
          "label": "Qui",
          "info": "Prenom, age."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · Voci"
    }
  ]
}
{% endschema %}
