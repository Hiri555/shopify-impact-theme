        },
        "a_14_heading": {
          "type": "heading",
          "settings": {
            "text": "Responsabilità"
          }
        },
        "a_15_paragraph": {
          "type": "paragraph",
          "settings": {
            "text": "<p>I contenuti informativi del sito hanno finalità divulgativa e non sostituiscono un parere medico. In presenza di sintomi persistenti la persona giusta è il medico, il dentista o l'otorino.</p>"
          }
        },
