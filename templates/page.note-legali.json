        "a_09_paragraph": {
          "type": "paragraph",
          "settings": {
            "text": "<p>DINSO VENTURES LLC vende online integratori alimentari con il marchio FREOS. I prodotti non sono farmaci e non hanno indicazioni terapeutiche.</p>"
          }
        },
        "a_10_custom": {
