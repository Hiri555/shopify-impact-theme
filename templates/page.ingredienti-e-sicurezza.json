        "a_06_paragraph": {
          "type": "paragraph",
          "settings": {
            "text": "<p><strong>Quello che non scriviamo.</strong> Non diciamo che lo zinco uccide i batteri: non è quello che fa. Non citiamo studi condotti su formule che contengono antisettici che noi non abbiamo.</p>"
          }
        },
