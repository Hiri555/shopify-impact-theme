        },
        "q2": {
          "type": "para",
          "settings": {
            "text": "<p>Ecco perché l’odore è più forte al risveglio, prima del caffè. Non è il caffè. È l’orario. E non esiste un collutorio per le sette ore in cui dormi.</p>"
          }
        }
