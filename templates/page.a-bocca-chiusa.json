    "apertura": {
      "type": "freos-lp-editorial",
      "blocks": {
        "a1": {
          "type": "para",
          "settings": {
            "text": "<p><strong>« Mi lavo i denti e dopo venti minuti è di nuovo cattivo. »</strong> La frase si ripete quasi identica in centinaia di discussioni italiane.</p>"
          }
        },
        "a2": {
          "type": "para",
          "settings": {
            "text": "<p>Per molti non ha senso: ci si lava, e passa. Per altri passa, e torna — anche senza aver mangiato niente. Non è una questione di igiene. È una questione di orari.</p>"
          }
        }
      },
      "block_order": [
