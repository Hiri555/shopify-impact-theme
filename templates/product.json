    "s3_momento": {
      "type": "freos-editorial",
      "blocks": {
        "s3_00_kicker": {
          "type": "kicker",
          "settings": {
            "text": "Il momento"
          }
        },
        "s3_01_heading": {
          "type": "heading",
          "settings": {
            "text": "Non è quanto. È quando."
          }
        },
        "s3_02_paragraph": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Di giorno la saliva scorre: passa, risciacqua, rinnova. Durante il sonno la sua produzione si riduce fin quasi ad azzerarsi.</p><p><em>Dawes C, Wong DTW · J Dent Res 2019 · PMID 30782091</em></p><p>Nella grande maggioranza dei casi — circa otto o nove su dieci secondo la letteratura — l'alito poco fresco ha origine <strong>in bocca</strong>, non nello stomaco.</p><p><em>Lee YH, Hong JY · Front Oral Health 2023 · Quirynen M et al. · J Clin Periodontol 2009 · PMID 19811581</em></p>"
          }
        },
        "s3_03_punch": {
          "type": "punch",
          "settings": {
            "text": "Ecco perché FREOS è un gesto della sera, e non un altro risciacquo della giornata: è l'ultimo passaggio prima delle ore in cui la bocca smette di difendersi."
          }
        },
        "s3_04_testimonial": {
          "type": "testimonial",
          "settings": {
            "quote": "Nonostante mi lavi i denti 3000 volte al giorno.",
            "source": "Commento pubblico italiano · id 9deb0c1bfbd8",
            "badge": "Corpus",
            "story": false
          }
        }
      },
      "block_order": [
