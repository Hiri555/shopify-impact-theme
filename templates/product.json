    "recensioni": {
      "type": "freos-pdp-recensioni",
      "blocks": {
        "rv1": {
          "type": "review",
          "settings": {
            "title": "La distanza",
            "body": "<p>Calcolo la distanza quando parlo, senza averlo deciso. Me ne accorgo solo dopo, ripensandoci.</p>"
          }
        },
        "rv2": {
          "type": "review",
          "settings": {
            "title": "La mano davanti",
            "body": "<p>Tengo la mano davanti alla bocca da anni, ormai è un gesto automatico. Non ricordo nemmeno quando ho cominciato.</p>"
          }
        },
        "rv3": {
          "type": "review",
          "settings": {
            "title": "Il cassetto pieno",
            "body": "<p>Il cassetto del bagno è pieno di cose comprate e mai finite. Collutori, spray, raschietti, tutti aperti a metà.</p>"
          }
        },
        "rv4": {
          "type": "review",
          "settings": {
            "title": "Il risveglio",
            "body": "<p>Il momento peggiore è il risveglio, prima ancora di mangiare. È lì che la domanda torna sempre uguale.</p>"
          }
        },
        "rv5": {
          "type": "review",
          "settings": {
            "title": "Non posso saperlo",
            "body": "<p>Vivo da solo e lavoro da casa. Il problema non è averlo: è non avere modo di saperlo.</p>"
          }
        },
        "rv6": {
          "type": "review",
          "settings": {
            "title": "Avevo smesso di cercare",
            "body": "<p>Ho smesso di comprare qualcosa per l’alito dopo dieci anni. Non perché fosse passato, ma perché avevo smesso di crederci.</p>"
          }
        }
      },
