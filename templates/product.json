    "s8_faq": {
      "type": "freos-editorial",
      "blocks": {
        "s8_00_section_header": {
          "type": "section_header",
          "settings": {
            "kicker": "Le domande scomode",
            "heading": "Cosa non fa",
            "dek": ""
          }
        },
        "s8_01_paragraph": {
          "type": "paragraph",
          "settings": {
            "text": "<ul><li><strong>Non cura l'alitosi.</strong> Non è un farmaco e non ha un'indicazione terapeutica.</li><li><strong>Non tocca le tonsille.</strong> Alla domanda « serve per i tonsilloliti? » la risposta è <strong>no</strong>.</li><li><strong>Non sostituisce</strong> lo spazzolino, né il dentista, né l'otorino.</li><li>Se non sopporti la menta, <strong>non fa per te</strong>.</li></ul>"
          }
        },
        "s8_02_faq": {
          "type": "faq",
          "settings": {
            "question": "Come si usa, esattamente?",
            "answer": "<p>Due misurini (1,2 g) la sera, dopo cena. Lascia sciogliere sulla lingua, poi deglutisci. Mai a stomaco vuoto.</p>",
            "open": false
          }
        },
        "s8_03_faq": {
          "type": "faq",
          "settings": {
            "question": "Quanto dura un barattolo?",
            "answer": "<p>120 g, circa 100 porzioni. Più o meno tre mesi, a due misurini a sera.</p>",
            "open": false
          }
        },
        "s8_04_faq": {
          "type": "faq",
          "settings": {
            "question": "Che sapore ha?",
            "answer": "<p>[SAPORE]</p>",
            "open": false
          }
        },
        "s8_05_faq": {
          "type": "faq",
          "settings": {
            "question": "Si deglutisce?",
            "answer": "<p>Sì, dopo averlo lasciato sciogliere sulla lingua.</p>",
            "open": false
          }
        },
        "s8_06_faq": {
          "type": "faq",
          "settings": {
            "question": "È un farmaco?",
            "answer": "<p>No. È un integratore alimentare.</p>",
            "open": false
          }
        },
        "s8_07_faq": {
          "type": "faq",
          "settings": {
            "question": "E se il problema viene dallo stomaco?",
            "answer": "<p>Raramente l'alito poco fresco viene dallo stomaco: le cause esterne alla bocca riguardano circa il 5-10% dei casi. <em>(Tangerman A &amp; Winkel EG · J Breath Res 2010 · PMID 21386205)</em> Se hai reflusso o sintomi digestivi, la persona giusta è il medico.</p>",
            "open": false
          }
        },
        "s8_08_faq": {
          "type": "faq",
          "settings": {
            "question": "Il mio dentista dice che è tutto a posto.",
            "answer": "<p>Ha ragione su quello che esamina: denti e gengive. La parte posteriore della lingua non rientra nella visita di controllo.</p>",
            "open": false
          }
        },
        "s8_09_faq": {
          "type": "faq",
          "settings": {
            "question": "Posso usarlo in gravidanza o durante l’allattamento?",
            "answer": "<p>No.</p>",
            "open": false
          }
        },
        "s8_10_faq": {
          "type": "faq",
          "settings": {
            "question": "Ci sono controindicazioni?",
            "answer": "<p>[AVVERTENZE_TE_VERDE]. In caso di dubbi, senti il medico o il farmacista.</p>",
            "open": false
          }
        },
        "s8_11_faq": {
          "type": "faq",
          "settings": {
            "question": "In quanto tempo si vedono i risultati?",
            "answer": "<p>Non te lo promettiamo. Quello che possiamo descrivere è l'installazione del gesto: la prima sera non cambia niente ed è normale; dopo qualche giorno diventa automatico; dopo due settimane è stabile, ed è lì che capisci se fa per te.</p>",
            "open": false
          }
        },
        "s8_12_faq": {
          "type": "faq",
          "settings": {
            "question": "Come funziona la garanzia?",
            "answer": "<p>30 giorni, per qualsiasi motivo, senza restituire il barattolo. Si aggiunge ai tuoi diritti di legge.</p>",
            "open": false
          }
        },
